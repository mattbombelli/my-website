{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@primitives/*": ["./src/components/primitives/*"],
      "@blocks/*": ["./src/components/blocks/*"],
      "@templates/*": ["./src/components/templates/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@data/*": ["./src/data/*"],
      "@images/*": ["./src/assets/images/*"],
      "@style/*": ["./src/styles/*"]
    }
  }
}
