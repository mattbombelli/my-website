---
import Layout from '@layouts/Layout.astro';

import PrimaryButton from '@blocks/PrimaryButton.astro';

import Figure from '@primitives/Figure.astro';
import Portrait from '@images/me.jpg';

import { breakpoints } from '@data/breakpoints.ts';
---
<style lang="scss">
  @use '../foundations' as *;

  section.grid{
    &#ingredients{
      gap: var(--space-2xl);

      div{
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
      }

      ul{
        list-style-type: none;
        display:flex;
        flex-direction: column;
        gap: var(--space-m);
        padding:0;
      }
    }

    &#instructions{
      --instructions-padding-block: var(--space-2xl);
      padding: var(--instructions-padding-block) var(--padding-inline);

      @media only screen and (min-width: $tablet){
        --instructions-padding-block: var(--space-3xl);
      }
    }
    
    &#ethics{
      background: var(--background);
      padding: var(--space-4xl) var(--padding-inline);
      *{
        color: var(--foreground);
      }
    }

    &#cta{
      --cta-padding-block: var(--space-3xl);
      padding: var(--cta-padding-block) var(--padding-inline);

      @media only screen and (min-width: $tablet){
        --cta-padding-block: var(--space-4xl);
      }

      :global(a){
        justify-self: center;
      }
    }

    &#colophon{
      --colophon-padding-block: var(--space-3xl);
      padding-bottom: var(--colophon-padding-block);

      @media only screen and (min-width: $tablet){
          --colophon-padding-block: var(--space-4xl);
          padding: var(--colophon-padding-block) var(--padding-inline);
      }
    }

  }

  @media only screen and (min-width: $tablet){
    :global(figure.col-center.full-bleed){
      max-width: 512px;
    }
    section.grid{
      &#header{
        padding-top: var(--space-3xl);
        padding-bottom: var(--space-4xl);

        h1, h2{
          text-align: center;
          max-width: 70%;
          justify-self: center;
        }
      }

      &#ingredients{
        column-gap: var(--gap-x);
        row-gap: var(--gap-y);

        div:last-of-type{
          padding-left: var(--space-m);
          border-left: 2px solid var(--foreground);
        }
      }

      &#instructions{
        column-gap: var(--gap-x-large);
      }
    } // section.grid
  } // $tablet

  @media only screen and (min-width: $laptop){
    :global(figure.col-center.full-bleed){
      grid-column: 2 / span 4;
      justify-self: center;
    }

    section.grid{
      &#ethics{
        p{
          grid-column: 2 / span 4;
          text-indent: var(--space-2xl);
        }
      }
    }
  }
</style>
<Layout title="About">
  <section id="portrait" class="grid full-bleed">
    <Figure 
      src={Portrait}
      alt="Myself holding my camera, in front of a mirror."
      class="col-center full-bleed"
      
      widths={[375, 540]}
      sizes=`
        (min-width: ${breakpoints.tablet}) 512px,
        100vw
      `
      formats={['webp']}
      layout='full-width'
      loading='eager'
    />
  </section>
  <section id="header" class="grid">
    <h1 class="h2 col-full">One part design, one part arts, one part craftsmanship</h1>
    <h2 class="h3 serif italic col-full">Your recipe for a multi-functional UXer</h2>
  </section>
  <section id="ingredients" class="grid">
      <div class="col-left-half">
        <h3 class="serif italic">Ingredients</h3>
        <ul class="h5">
          <li>1 Mattia</li>
          <li>1 tsp frontend web dev</li>
          <li>100g Gothic Art</li>
          <li>200g illustration</li>
          <li>2tbsp leathercrafting</li>
        </ul>
      </div>
      <div class="col-right-half">
        <h3 class="serif italic">Toppings</h3>
        <ul class="h5">
          <li>1 adorable turtle</li>
          <li>Cooking</li>
          <li>Music</li>
          <li>Photography</li>
        </ul>
      </div>
  </section>
  <section id="instructions" class="grid">
    <h2 class="serif italic col-full">Instructions</h2>
    <div class="prose col-left-half">
      <p class="h6 sans-serif weight-regular justified">
        Marinate Mattia with French Expressionism and Gothic art, then add some finely chopped ardour for illustration and storytelling.</p>
      <p class="h6 sans-serif weight-regular justified">
        Store him in the Illustration & Animation school of the European Institute of Design (IED) in Milan, Italy, for a few years.
      </p>
      <p class="h6 sans-serif weight-regular justified">
        Once marinated, move him to Vancouver, Canada: keep stirring until he becomes a web developer through further college studies.
      </p>
    </div>
    <div class="prose col-right-half">
      <p class="h6 sans-serif weight-regular justified">
        Sauté in freelancing work. Once done, transfer to Keycafe and gently pat him with an extensive variety of multidisciplinary design projects.  Repeat for several years until he becomes the company's Senior Designer.
      </p>
      <p class="h6 sans-serif weight-regular justified">
        To serve, spread with a lovely turtle named Juanita. Top with a fascination for languages and music production. Serve warm.
      </p>
      <p class="h6 sans-serif weight-regular justified">
        Good job! You can now enjoy your new multi-functional designer.
      </p>
    </div>
  </section>
  <section id="ethics" class="grid" data-theme-mode="invert">
    <p class="h6 sans-serif weight-regular col-full">
      Store him in the Illustration & Animation school of the European Institute of Design (IED) in Milan, Italy, for a few years. Store him in the Illustration & Animation school of the European Institute of Design (IED) in Milan, Italy, for a few years.
    </p>
  </section>
  <section id="cta" class="grid">
    <PrimaryButton 
      href="mailto:hello@mattiabombelli.com"
      label="Get in touch"
      theme="hibiscus-mono"
      class="col-full"
      hover="cove"
      hoverMode="invert"
      cta
      border
      shape={{
        variant: "star",
        fill: "mustard",
        themeMode: "invert",
      }}
      icon={{
        icon: "envelope",
        fill: "verdant",
        themeMode: "invert",
      }}
    />
  </section>
  <section id="colophon" class="grid">
    <h3 class="col-left-wide h4 serif">Colophon</h3>
    <p class="col-left-wide h6 sans-serif weight-regular">
      Every design has its influences. Here’s a small part of this one’s family tree:
    </p>
    <p class="col-left-wide h6 sans-serif weight-regular">
      Inspirations include: Monocle, Kinfolk, Aperture and Uppercase printed magazines; Memphis Group’s style, and risograph color palettes. <br />
      Typography: Nudica by atipo foundry; Libre Baskerville by Impallary Type.
    </p>
    <p class="col-left-wide h6 sans-serif weight-regular">
      Designed in Figma and developed with Astro.js.<br />
      Built to show my work as UX designer, and as a person.
    </p>
  </section>
</Layout>