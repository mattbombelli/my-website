---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '@root/keystatic.config';
import Layout from '@layouts/Layout.astro';
import PrimaryButton from '@blocks/PrimaryButton.astro';
import ProjectCard from '@templates/ProjectCard.astro';
import { breakpoints } from '@data/breakpoints.ts';
import { resolveImageOrThrow } from '@utils/resolveImageOrThrow.ts';
import { resolveImageWithPlaceholder } from '@utils/resolveImageWithPlaceholder.ts';
import readingTimesData from '../content/_generated/reading-times.json';
import Figure from '@primitives/Figure.astro';
import Icon from '@primitives/Icon.astro';
import RevealParagraph from '@primitives/RevealParagraph.astro';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.caseStudies.list();

const readingTimes = readingTimesData as { caseStudies: Record<string, string>};

const caseStudies = await Promise.all(
  slugs.map(async (slug) => ({
    slug,
    ...(await reader.collections.caseStudies.read(slug, { resolveLinkedFiles: true })),
  }))
);

const { image: cover, placeholderStyle } = await resolveImageWithPlaceholder('@images/face.png');
---
<style lang="scss">
  @use '../foundations' as *;
    section{
      &#intro{
        border-top-width: var(--space-xl);
        border-top-style: solid;
        border-top-color: var(--marmalade-base);
        background: var(--background);

        :global(h1){
          grid-column: span 2;
          // letter-spacing: -1.1;
        }
        
        a:visited{
          color: var(--ink-base);
        }

        .description{
          display: flex;
          flex-direction: column;
          gap: var(--space-l);

          grid-column: span 2;

          :global(p){
            @include body-text("h5", 400, "sans-serif");
          }
        }

        @media only screen and (min-width: $tablet){
          .description{
            :global(p){
              @include body-text("h3", 400, "sans-serif");
            }
          }

          .description{
            grid-column: span 3;
          }
        } // $tablet

        @media only screen and (min-width: $laptop){
        } // $laptop

        @media only screen and (min-width: $desktop){
        }

      } // #intro

      &#expertise{
        gap: var(--space-xl);
        background: var(--background);
        color: var(--foreground);

        .list{
          gap: var(--space-s);
          
          ul{
            list-style-type: none;
            padding-left: 0;
          }
          
          &:nth-of-type(1){ 
            display: flex;
            flex-direction: column;

            grid-row: 1/2;
            grid-column: span 2;
          }

          &:nth-of-type(2){ 
            grid-row: 2/3;
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: subgrid;

            h2{ grid-column: span 2;}

            hr{
              grid-column: 1 / -1;
              width:100%;
              border: 0;
              margin: 0;
              background: var(--foreground);
              height: calc( var(--space-3xs) / 2 );
            }

            div{
              display: flex;
              flex-direction: column;
              gap: inherit;
              grid-column: span 1;
            }
          }

          h2, h3{
            @include body-text("p", 700, "sans-serif");
          }
        }

        @media only screen and (min-width: $tablet){
          .list:nth-of-type(2){
            div{
              grid-column: span 2;
            }
          }
        }

        @media only screen and (min-width: $laptop){
          padding-block: var(--padding-block-extra);
          .list{
            &:nth-of-type(1){
              gap: calc( ( var(--space-s) * 2 ) + ( var(--space-3xs) / 2 ) );
            }
            &:nth-of-type(2){
              grid-row: 1 / 2;
              grid-column: 3 / span 4;
            }
          }
        }
      } // #expertise

      &#highlighted-projects{
        display: flex;
        flex-direction: column;
        gap: var(--gap-y);
        margin-bottom: var(--space-xl-4xl);
      }

    } // section

</style>

<Layout title="Home">
  <section id="intro" class="grid" data-theme="default">
    <div class="description">
      <RevealParagraph as="h1" class="full-screen">Good design is for everyone.</RevealParagraph>
      <RevealParagraph>
        I am Mattia, a designer specializing in UX: from research and testing, to design systems and prototyping. Accessibility is at the core of my practice. Human-centred & ethical design is my philosophy.
      </RevealParagraph>
      <RevealParagraph>
        Currently Senior Designer at <a href="https://www.keycafe.com/s/" target="_blank">Keycafe.</a> <Icon icon="externalLink" />
      </RevealParagraph>
    </div>
  </section>
  <section class="grid" id="expertise" data-theme="jungle">
    <div class="list">
      <h2>Disciplines</h2>
      <ul>
        <li class="weight-bold sans-serif">UI /</li>
        <li class="weight-bold sans-serif">UX /</li>
        <li class="weight-bold sans-serif">Frontend development /</li>
        <li class="sans-serif">Illustration /</li>
        <li class="sans-serif">3D /</li>
        <li class="sans-serif">Graphic design /</li>
      </ul>
    </div>

    <div class="list">
      <h2>Tools of the trade</h2>
      <hr>
      <div>
        <h3>Design</h3>
        <ul>
          <li class="sans-serif">Figma</li>
          <li class="sans-serif">Illustrator</li>
          <li class="sans-serif">Blender</li>
          <li class="sans-serif">InDesign</li>
          <li class="sans-serif">After Effects</li>
        </ul>
      </div>
      <div>
      <h3>Development</h3>
        <ul>
          <li class="sans-serif">HTML/CSS</li>
          <li class="sans-serif">Javascript</li>
          <li class="sans-serif">Astro.js</li>
          <li class="sans-serif">Webflow</li>
        </ul>
      </div>
    </div>
  </section>
  <section id="highlighted-projects">
    {caseStudies.map(async caseStudy => {
      const cover = await resolveImageOrThrow(caseStudy.cover);
      return (
        <ProjectCard
          title={caseStudy.title}
          excerpt={caseStudy.excerpt}
          image={{
            src: cover,
            alt: caseStudy.coverAlt,
            widths: [375, 540],
            sizes: `
                (min-width: ${breakpoints.tablet}) 512px,
                100vw
              `,
            formats: ['webp'],
            fit: 'cover',
            layout: 'constrained',
            style: `
                --blurhash-gradient: url("${cover.placeholder}");
            `
          }}
          readingTime={`${readingTimes.caseStudies[caseStudy.slug]} read`}
          tags={caseStudy.tags}
          button={{
            href: "/ux/" + caseStudy.slug,
            theme: 'marmalade',
            themeMode: 'normal',
            hover: 'mustard',
            shape: {
              variant: 'spring',
              fill: 'meadow',
              themeMode: 'invert',
            },
            icon: {
              icon: 'arrowRight',
              fill: 'cove',
              themeMode: "invert",
            }
          }}
          style={`--metadata-bg: var(--paper-base);`}
        />
      );
    })}
  </section>
</Layout>

<script>
  function fitToViewport(el: HTMLElement) {
  let span = el.querySelector<HTMLElement>(':scope > span.fit-measure');

  if (!span) {
    span = document.createElement('span');
    span.className = 'fit-measure';
    span.style.whiteSpace = 'nowrap';
    while (el.firstChild) span.appendChild(el.firstChild);
    el.appendChild(span);
  }

  const target = el.clientWidth;

  el.style.fontSize = '100px';
  let w = span.getBoundingClientRect().width;
  el.style.fontSize = `${(100 * target) / w}px`;

  w = span.getBoundingClientRect().width;
  const current = parseFloat(el.style.fontSize);
  el.style.fontSize = `${current * (target / w)}px`;
}
const heading = document.querySelector<HTMLElement>('.full-screen');

if (heading) {
  fitToViewport(heading);

  let ticking = false;
  window.addEventListener('resize', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        fitToViewport(heading);
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
}

