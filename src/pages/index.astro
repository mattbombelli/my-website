---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '@root/keystatic.config';
import Layout from '@layouts/Layout.astro';
import PrimaryButton from '@blocks/PrimaryButton.astro';
import ProjectCard from '@templates/ProjectCard.astro';
import { breakpoints } from '@data/breakpoints.ts';
import { resolveImageOrThrow } from '@utils/resolveImageOrThrow';
import readingTimesData from '../content/_generated/reading-times.json';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const slugs = await reader.collections.caseStudies.list();

const readingTimes = readingTimesData as { caseStudies: Record<string, string>};

const caseStudies = await Promise.all(
  slugs.map(async (slug) => ({
    slug,
    ...(await reader.collections.caseStudies.read(slug, { resolveLinkedFiles: true })),
  }))
);
---
<style lang="scss">
  @use '../foundations' as *;

  section{
    &:nth-of-type(1){
      color:var(--foreground);
      background:var(--background);

      pre{
        grid-column: span 2;
      }
    }

    &#about-me{
      --section-padding-block: var(--space-4xl);
      --section-gap: var(--space-2xl);

      padding: var(--section-padding-block) var(--padding-inline);
      row-gap: var(--section-gap);

      background:var(--background);
      p{
        color: var(--foreground);
      }

      :global(a){
        justify-self: center;
      }
    }

    &#highlighted-projects{
      display: flex;
      flex-direction: column;
      gap: var(--gap-y);
      padding-top: var(--space-3xl);
    }

    &#cta{
      --cta-padding-block: var(--space-3xl);
      padding: var(--cta-padding-block) var(--padding-inline);

      @media only screen and (min-width: $tablet){
        --cta-padding-block: var(--space-4xl);
      }

      :global(a){
        justify-self: center;
      }
    }
  } // section.grid

  @media only screen and (min-width: $tablet){
    section.grid{
      &#about-me{
        p{
          grid-column: span 3 / 5;
        }
        :global(a){
          grid-column: span 4;
          justify-self: right;
        }
      }
    } // section.grid
  } // $tablet

  @media only screen and (min-width: $laptop){
    section.grid{
      &#about-me{
        p{
          grid-column: span 3 / 7;
        }
        :global(a){
          grid-column: span 4 / 7;
          justify-self: right;
        }
      }
    } // section.grid
  } // $laptop
</style>

<Layout title="Home">
  <section class="grid">
    <h1>Welcome to my website! Benvenuti nel mio sito</h1>
    <pre>
    /\_____/\
   /  o   o  \
  ( ==  ^  == )
   )         (
  (           )
 ( (  )   (  ) )
(__(__)___(__)__)
      
    </pre>
  </section>
  <section
    id="about-me"
    class="grid"
    data-theme="meadow-mono"
    data-theme-mode="invert"
  >
    <p class="h4 weight-regular col-right-half justified">
      I am Mattia and this is where I talk a bit about me. I explain my values as designer, my vision, and what I care about. This will be the description where I talk a bit about me. I explain my values as designer, my vision, and what I care about.
    </p>
    <PrimaryButton 
      href="/about"
      label="More about me"
      theme="meadow-mono"
      class="col-right-wide"
      hover="default"
      shape={{
        variant: "trapezoid",
        fill: "meadow-mono",
        themeMode: "invert",
      }}
      icon={{
        icon: "arrowRight",
        fill: "flame-mono",
      }}
    />
  </section>
  <section id="highlighted-projects">
    {caseStudies.map(async caseStudy => {
      const cover = await resolveImageOrThrow(caseStudy.cover);
      return (
        <ProjectCard
          title={caseStudy.title}
          excerpt={caseStudy.excerpt}
          image={{
            src: cover,
            alt: caseStudy.coverAlt,
            widths: [375, 540],
            sizes: `
                (min-width: ${breakpoints.tablet}) 512px,
                100vw
              `,
            formats: ['webp'],
            fit: 'cover',
            layout: 'constrained',
            style: `
                --blurhash-gradient: url("${cover.placeholder}");
            `
          }}
          readingTime={`${readingTimes.caseStudies[caseStudy.slug]} read`}
          button={{
            href: "/ux/" + caseStudy.slug,
            theme: 'marmalade',
            hover: 'mustard',
            shape: {
              variant: 'spring',
              fill: 'meadow',
              themeMode: 'invert',
            },
            icon: {
              icon: 'arrowRight',
              fill: 'chocolate',
              themeMode: "invert",
            }
          }}
        />
      );
    })}
  </section>
  <section
    id="cta"
    class="grid"
  >
    <PrimaryButton 
      href="mailto:hello@mattiabombelli.com"
      label="View all case studies"
      theme="marmalade"
      class="col-full"
      hover="mustard"
      hoverMode="normal"
      cta
      shape={{
        variant: "donut",
        fill: "meadow",
        themeMode: "invert",
      }}
      icon={{
        icon: "arrowRight",
        fill: "chocolate",
        themeMode: "invert",
      }}
    />
  </section>
</Layout>

