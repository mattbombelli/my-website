---
import { reader } from '@utils/reader';
import { loadProjectSections } from '@utils/loadProjectSections';

import Layout from '../../layouts/Layout.astro';
import Figure from '@primitives/Figure.astro';
import MarkdocDocument from '@primitives/MarkdocDocument.astro';
import Carousel from '@blocks/Carousel.astro';
import PrimaryButton from '@blocks/PrimaryButton.astro';

export async function getStaticPaths() {
    const slugs = await reader.collections.illustrations.list();
    return slugs.map(slug => ({ params: { slug } }));
}
export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');

const { project: caseStudy, sections } = await loadProjectSections(
    reader.collections.illustrations,
    slug,
    'src/content/illustration'
);
---
<style lang="scss">
    @use '../../foundations' as *;

    main.grid{
        position: relative;
        padding-left: 0;
        padding-right: 0;

        aside{
            display: none;
        }
    }

    header{
        text-align: center;
        margin-top: var(--space-3xl);
    }


    @media only screen and (min-width: $laptop){
        main.grid{
            padding: var(--padding-block) var(--padding-inline);

            :global(aside){
                display: block;

                z-index: 1;
                grid-column: 1 / span 2;
                grid-row: 1;
                position: sticky;
                top: var(--space-m);
                align-self: start;
                max-height: calc(100dvh - var(--space-m) * 2);
                overflow-y: auto;

            }

            :global(aside::-webkit-scrollbar) {
                width: var(--space-2xs);
            }
            
            :global(aside::-webkit-scrollbar-track) {
                background: transparent;
            }
                
            :global(aside::-webkit-scrollbar-thumb) {
                background: var(--cobalt-base);
                border-radius: var(--radius-pill);
            }
        }

    }

    article{
        grid-row: 2;
        grid-column: span 2;
        display: grid;
        row-gap: inherit;
        grid-template-columns: repeat(2, 1fr);
        column-gap: var(--gap-x);
        
        @media only screen and (min-width: $tablet){
            grid-column: span 4;
            grid-template-columns: repeat(4, 1fr);
        }
        
        @media only screen and (min-width: $laptop){
            grid-row: 1;
            grid-template-columns: repeat(4, 1fr);
        }
    }

    section.grid, header{
        --custom-row-gap: var(--gap-y);

        background: var(--background);
        color: var(--foreground);

        row-gap: var(--custom-row-gap);

        grid-column: 1 / -1;
        grid-template-columns: subgrid;

        .zone.has-drop-cap {
            :global(p:first-of-type:first-letter) {
                @include drop-cap;
            }
        }

        .zone{
            grid-column: span 2;
            order: var(--mobile-order, "initial");
            background: var(--background);
            color: var(--foreground);

            :global(p){
                @include justified;
            }

            :global(.primary-button){
                width: 100%;
                :global(span.button){
                    flex-basis: unset;
                    flex-grow: 1;
                    min-width: unset;
                }
            }

            &[data-theme-mode="invert"]{
                padding: var(--space-m);
            }

            @media only screen and (min-width: $tablet){
                &.align-right,
                &.align-right :global(hgroup p){
                    text-align: right;
                    text-align-last: unset;
                }

                &.align-center,
                &.align-center :global(hgroup p){
                    text-align: center;
                    text-align-last: unset;
                }

                grid-column: var(--offset-tablet, 2) / span var(--span-tablet, 2);
                grid-row: var(--row-offset-tablet, auto) / var(--row-span-tablet, auto);
                padding:unset;
            }

            @media only screen and (min-width: $laptop){
                grid-column: var(--offset-default, 2) / span var(--span-default, 2);
                grid-row: var(--row-offset-default, auto) / var(--row-span-default, auto);
            }

        } // zone
    } // section
</style>

<Layout title={caseStudy.title}>
    <header class="grid">
        <h1 class="col-full">{caseStudy.title}</h1>
    </header>
    <main class="grid">
        <article
            id="article-content"
            class="prose"
        >
            {
                sections.map((section, sectionIndex) => {

                    return <section
                                class="grid"
                                style={`
                                    --custom-row-gap: ${section.rowGap};
                                `}
                                data-theme="default"
                                data-theme-mode={section.theme}
                            >
                        {section.carousel
                            ? <Carousel
                                id={`carousel-${sectionIndex}`}
                                ariaLabel={section.description}
                                slides={section.zones
                                        .filter(zone => zone.content.discriminant)
                                        .map(zone => {

                                            const value = zone.content.value as {
                                                image: string;
                                                alt: string;
                                                caption: string;
                                                loading: 'lazy' | 'eager';
                                            };
                                            return {
                                                src: value.image,
                                                alt: value.alt,
                                                caption: value.caption,
                                                desktop: {
                                                    columnOffset: zone.desktop.columnOffset,
                                                    columnSpan: zone.desktop.columnSpan,
                                                    rowOffset: zone.desktop.rowOffset,
                                                    rowSpan: zone.desktop.rowSpan
                                                },
                                                tablet: {
                                                    columnOffset: zone.tablet.columnOffset,
                                                    columnSpan: zone.tablet.columnSpan,
                                                    rowOffset: zone.tablet.rowOffset,
                                                    rowSpan: zone.tablet.rowSpan,
                                                }
                                            }
                                        })
                                }
                            />

                            : section.zones.map((zone) => (

                                <div
                                    class:list={[
                                        "zone",
                                        zone.textAlignment && zone.textAlignment !== "left" && `align-${zone.textAlignment}`,
                                        zone.invertType && `invert-types`,
                                        zone.hasDropCap && `has-drop-cap`,
                                    ]}
                                    data-theme-mode={zone.zoneThemeMode ? "invert" : undefined}

                                    style={`
                                        --span-default: ${zone.desktop.columnSpan};
                                        --offset-default: ${zone.desktop.columnOffset};
                                        --span-tablet: ${zone.tablet.columnSpan};
                                        --offset-tablet: ${zone.tablet.columnOffset};

                                        --row-span-default: ${zone.desktop.rowSpan === 'auto' ? 'auto' : `span ${zone.desktop.rowSpan}`};
                                        --row-offset-default: ${zone.desktop.rowOffset};
                                        --row-span-tablet: ${zone.tablet.rowSpan === 'auto' ? 'auto' : `span ${zone.tablet.rowSpan}`};
                                        --row-offset-tablet: ${zone.tablet.rowOffset};
                                        order: ${ zone.mobileOrder == 0 ? "initial" : zone.mobileOrder};
                                    `}
                                >
                                    <MarkdocDocument>
                                        { zone.content.discriminant && zone.resolvedImage
                                            ? <Figure
                                                class="full-bleed"
                                                src={zone.resolvedImage}
                                                alt={zone.content.value.alt}
                                                caption={zone.content.value.caption}
                                                loading={zone.content.value.loading}
                                                style={`
                                                    --blurhash-gradient: url("${zone.resolvedImage.placeholder}");
                                                `}
                                            />
                                            : zone.segments?.map((segment) =>
                                                segment.type === 'html'
                                                    ? <Fragment set:html={segment.content} />
                                                    : <PrimaryButton
                                                        href={segment.content.href}
                                                        label={segment.content.label}
                                                        theme={segment.content.mainTheme}
                                                        themeMode={segment.content.mainThemeMode}
                                                        hover={segment.content.hoverTheme}
                                                        hoverMode={segment.content.hoverThemeMode}
                                                        shape={{
                                                            variant: segment.content.shape,
                                                            fill: segment.content.shapeTheme,
                                                            themeMode: segment.content.shapeThemeMode,
                                                        }}
                                                        icon={{
                                                            icon: segment.content.icon,
                                                            fill: segment.content.iconTheme,
                                                            themeMode: segment.content.iconThemeMode,
                                                        }}
                                                        target="_blank"
                                                    />
                                            )
                                        }
                                    </MarkdocDocument>
                                </div>
                            ))}
                    </section>
                })
            }
        </article>
    </main>
</Layout>