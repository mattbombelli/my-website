---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const caseStudy = await getEntry('caseStudies', slug);

if (!caseStudy) throw new Error('No post found for this slug');
const { Content } = await render(caseStudy);

// Generate static pages
export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies');
  return caseStudies.map(post => ({ params: { slug: post.id } }));
}
---

<Layout title={caseStudy.data.title}>
    <section class="grid">
        <h1>{caseStudy.data.title}</h1>
    </section>
    <section class="grid">
        <Content />
    </section>
</Layout>
