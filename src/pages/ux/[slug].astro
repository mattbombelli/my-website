---
import { createReader } from '@keystatic/core/reader';
import { resolveImage } from '../../utils/resolveImage';
import keystaticConfig from '@root/keystatic.config';
import { parse } from 'node-html-parser';
import Markdoc from '@markdoc/markdoc';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { extractHeadings } from '@utils/extractHeadings';
import TableOfContents from '@blocks/TableOfContents.astro';
import readingTimesData from '../../content/_generated/reading-times.json';

import Layout from '../../layouts/Layout.astro';
import Figure from '@primitives/Figure.astro';
import MarkdocDocument from '@primitives/MarkdocDocument.astro';
import Carousel from '@blocks/Carousel.astro';

export async function getStaticPaths() {
    const reader = createReader(process.cwd(), keystaticConfig);
    const slugs = await reader.collections.caseStudies.list();
    return slugs.map(slug => ({ params: { slug }}));
}
export const prerender = true;

const readingTimes = readingTimesData as { caseStudies: Record<string, string>};

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');

const reader = createReader(process.cwd(), keystaticConfig);
const caseStudy = await reader.collections.caseStudies.read(slug, { resolveLinkedFiles: true });
if (!caseStudy) throw new Error('No post found with this slug');

function stripArticleWrapper(html: string): string {
    const root = parse(html);
    const article = root.querySelector('article');
    const container = article ? article : root;
    return container.innerHTML;
}

function wrapSubtitle(html: string): string {
    const root = parse(html);
    const heading = root.querySelector('h1, h2');
    const next = heading?.nextElementSibling;

    if (heading && next && next.tagName === 'P') {
        const wrapped = `<hgroup>${heading.outerHTML}${next.outerHTML}</hgroup>`;
        heading.replaceWith(wrapped);
        next.remove();
    }

    return root.toString();
}

const sections = await Promise.all(
    caseStudy.sections.map(async (section, sectionIndex) => ({
        ...section,
        zones: await Promise.all(
            section.zones.map(async (zone, zoneIndex) => {
                const textAlignment = !zone.content.discriminant
                        ? zone.content.value.alignment
                        : null;

                const invertType = !zone.content.discriminant
                        ? zone.content.value.typography
                        : null;

                const hasSubtitle = !zone.content.discriminant
                        ? zone.content.value.subtitle
                        : false;

                const zoneThemeMode = !zone.content.discriminant
                        ? zone.content.value.theme
                        : false;

                let contentHtml = null;
                let zoneHeadings: {
                    type: 'h1' | 'h2' | 'h3';
                    link: string;
                    label: string
                }[] = [];

                if (!zone.content.discriminant) {
                    const filePath = join(
                        process.cwd(),
                        'src/content/ux',
                        slug,
                        `sections/${sectionIndex}/zones/${zoneIndex}/content/value/content.mdoc`
                    );

                    const raw = await readFile(filePath, 'utf-8');
                    const ast = Markdoc.parse(raw);
                    const transformed = Markdoc.transform(ast);
                    const html = Markdoc.renderers.html(transformed);
                    const stripped = stripArticleWrapper(html);
                    
                    const withSubtitle = hasSubtitle ? wrapSubtitle(stripped) : stripped;

                    const extracted = extractHeadings(withSubtitle);
                    contentHtml = extracted.html;
                    zoneHeadings = extracted.headings;
                }

                return {
                    ...zone,
                    resolvedImage: await resolveImage(
                        zone.content.discriminant
                            ? zone.content.value.image
                            : null
                    ),
                    textAlignment,
                    invertType,
                    zoneThemeMode,
                    contentHtml,
                    zoneHeadings,
                }
            })
        )
    }))
); // sections

const fullArticleHtml = sections
    .flatMap((section) => section.zones)
    .map((zone) =>zone.contentHtml ?? '')
    .join('');

const readingTime = readingTimes.caseStudies[slug];

const allHeadings = sections.flatMap((section) =>
    section.zones.flatMap((zone) => zone.zoneHeadings)
);
---
<style lang="scss">
    @use '../../foundations' as *;

    main.grid{
        position: relative;
        padding-left: 0;
        padding-right: 0;
    }

    header{
        text-align: center;
        margin-top: var(--space-3xl);
    }

    @media only screen and (min-width: $laptop){
        main.grid{
            padding: var(--padding-block) var(--padding-inline);
        }

        aside{
            z-index: 1;
            grid-column: 1 / span 2;
            grid-row: 1;
        }
    }

    article{
        grid-row: 1;
        grid-column: span 4;
        display: grid;
        row-gap: inherit;
        grid-template-columns: repeat(2, 1fr);
        column-gap: var(--gap-x);
        
        @media only screen and (min-width: $tablet){
            grid-template-columns: repeat(4, 1fr);
        }
        
        @media only screen and (min-width: $laptop){
            grid-template-columns: repeat(4, 1fr);
        }
    }

    section.grid, header{
        --custom-row-gap: var(--gap-y);

        background: var(--background);
        color: var(--foreground);

        row-gap: var(--custom-row-gap);

        grid-column: 1 / -1;
        grid-template-columns: subgrid;

        &:first-of-type{
            .zone:nth-child(1 of :has(p, .p)){
                :global(p:first-of-type:first-letter){
                    @include drop-cap;
                }
            }
        }

        .zone{
            grid-column: span 2;
            order: var(--mobile-order, "initial");
            background: var(--background);
            color: var(--foreground);

            :global(p){
                @include justified;
            }

            &[data-theme-mode="invert"]{
                padding: var(--space-m);
            }

            @media only screen and (min-width: $tablet){
                &.align-right,
                &.align-right :global(hgroup p){
                    text-align: right;
                    text-align-last: unset;
                }

                &.align-center,
                &.align-center :global(hgroup p){
                    text-align: center;
                    text-align-last: unset;
                }

                grid-column: var(--offset-tablet, 2) / span var(--span-tablet, 2);
                grid-row: var(--row-offset-tablet, auto) / var(--row-span-tablet, auto);
                padding:unset;
            }

            @media only screen and (min-width: $laptop){
                grid-column: var(--offset-default, 2) / span var(--span-default, 2);
                grid-row: var(--row-offset-default, auto) / var(--row-span-default, auto);
            }

        } // zone
    } // section
</style>

<Layout title={caseStudy.title}>
    <header class="grid">
        <h1 class="col-full">{caseStudy.title}</h1>
    </header>
    <main class="grid">
        <article class="prose">
            {
                sections.map((section, sectionIndex) => {

                    return <section
                                class="grid"
                                style={`
                                    --custom-row-gap: ${section.rowGap};
                                `}
                                data-theme="default"
                                data-theme-mode={section.theme}
                            >
                        {section.carousel
                            ? <Carousel
                                id={`carousel-${sectionIndex}`}
                                ariaLabel={section.description}
                                slides={section.zones
                                        .filter(zone => zone.content.discriminant)
                                        .map(zone => {

                                            const value = zone.content.value as {
                                                image: string;
                                                alt: string;
                                                caption: string;
                                                loading: 'lazy' | 'eager';
                                            };
                                            return {
                                                src: value.image,
                                                alt: value.alt,
                                                caption: value.caption,
                                                desktop: {
                                                    columnOffset: zone.desktop.columnOffset,
                                                    columnSpan: zone.desktop.columnSpan,
                                                    rowOffset: zone.desktop.rowOffset,
                                                    rowSpan: zone.desktop.rowSpan
                                                },
                                                tablet: {
                                                    columnOffset: zone.tablet.columnOffset,
                                                    columnSpan: zone.tablet.columnSpan,
                                                    rowOffset: zone.tablet.rowOffset,
                                                    rowSpan: zone.tablet.rowSpan,
                                                }
                                            }
                                        })
                                }
                            />

                            : section.zones.map((zone) => (

                                <div
                                    class:list={[
                                        "zone",
                                        zone.textAlignment && zone.textAlignment !== "left" && `align-${zone.textAlignment}`,
                                        zone.invertType && `invert-types`,
                                    ]}
                                    data-theme-mode={zone.zoneThemeMode ? "invert" : undefined}

                                    style={`
                                        --span-default: ${zone.desktop.columnSpan};
                                        --offset-default: ${zone.desktop.columnOffset};
                                        --span-tablet: ${zone.tablet.columnSpan};
                                        --offset-tablet: ${zone.tablet.columnOffset};

                                        --row-span-default: ${zone.desktop.rowSpan === 'auto' ? 'auto' : `span ${zone.desktop.rowSpan}`};
                                        --row-offset-default: ${zone.desktop.rowOffset};
                                        --row-span-tablet: ${zone.tablet.rowSpan === 'auto' ? 'auto' : `span ${zone.tablet.rowSpan}`};
                                        --row-offset-tablet: ${zone.tablet.rowOffset};
                                        order: ${ zone.mobileOrder == 0 ? "initial" : zone.mobileOrder};
                                    `}
                                >
                                    <MarkdocDocument>
                                        { zone.content.discriminant && zone.resolvedImage
                                            ? <Figure
                                                class="full-bleed"
                                                src={zone.resolvedImage}
                                                alt={zone.content.value.alt}
                                                caption={zone.content.value.caption}
                                                loading={zone.content.value.loading}
                                                style={`
                                                    --blurhash-gradient: url("${zone.resolvedImage.placeholder}");
                                                `}
                                            />
                                            : zone.contentHtml && <Fragment set:html={zone.contentHtml} />
                                        }
                                    </MarkdocDocument>
                                </div>
                            ))}
                    </section>
                })
            }
        </article>
        <aside>
            <TableOfContents
                page={caseStudy.title}
                pageLink="#top"
                chapters={allHeadings}
                readingTime={readingTime}
            />
        </aside>
    </main>
</Layout>