---
import '@style/global.scss';

import Link from '@primitives/Link.astro';
import { mainNavLinks } from '@data/navigation.ts';
import Icon from '@primitives/Icon.astro';

const currentPage = Astro.url.pathname;
---
<style lang="scss">
    @use '../../foundations' as *;

    nav#main-menu{
        align-items: center;
        padding-top: var(--space-m);
        padding-bottom: var(--space-m);

        // hiding desktop menu on mobile
        ul{ 
            display: none;
        }

        & > :global(a:first-of-type){
            justify-self: left;
        }

        // hiding cta on mobile
        & > :global(a:last-of-type){
            display:none;
        }

        button{
            justify-self: right;
        }
    }
    
    button.hamburger{
        display: inline-grid;
        place-items: center;
        background: var(--background);
        border: none;
        border-radius: var(--radius-pill);
        padding: var(--space-xs);
        aspect-ratio: 1/1;
        cursor: pointer;
        transition: background var(--duration-default) var(--ease-default);

        &:focus-visible {
            outline: none;
            box-shadow: 0px 0px 0px 0.3em var(--paper-base), 0px 0px 0px 0.4em var(--foreground);
        }

        &.no-focus-ring:focus-visible {
            outline: none;
            box-shadow: none;
        }
    }

    // general styling for ul within navbar
    ul{
        margin: 0;
        list-style-type: none;
        padding: 0;
    }

    // displaying mobile menu through dialog
    :global(body:has(dialog[open])){
        overflow: hidden;
    }

    dialog{
        background: var(--background);

        margin: 0;
        width: 100%;
        height: 100dvh;
        max-width: none;
        max-height: none;
        padding:0;
        border:none;

        ::backdrop{
            background: var(--background);
        }

        
        div.header{
            padding-top: var(--space-m);
            padding-bottom: var(--space-m);
            align-items: center;

            :global(a){
                // font-weight: 500;
            }

            :global(a:first-of-type){
                justify-self: left;
            }

            button{
                grid-column: 2/3;
                justify-self: right;
                background: var(--background);
                border: none;
                position: relative;
                cursor: pointer;
            }
        }

        nav{
            display: flex;
            flex-direction: column;
            justify-content: center;

            padding: var(--space-m) var(--padding-inline);
            gap: var(--gap-y);

            ul, div{
                display: flex;
                flex-direction: column;
                padding: var(--space-s) var(--padding-inline);
                gap: var(--gap-y-small);
                background: var(--background);

                li{
                    position:relative;
                }
                
                :global(a){
                    transition: text-indent var(--duration-default) var(--ease-default);
                    width: 100%;
                    
                    @media (hover: hover) and (pointer: fine){
                        &:hover,
                        &:focus-visible{
                            text-indent: var(--space-xs);
                        }
                    }
                }
            }

            address{
                text-align: center;
            }
        }
    }

    @media(prefers-reduced-motion: no-preference){

        @keyframes fadeFromTop{
            from {
                opacity: 0;
                translate: 0 -1em;
            }
            to {
                opacity: 1;
                translate: 0 0;
            }
        }

        dialog{
            
            nav{

                ul, div, address{
                    animation: fadeFromTop var(--duration-default) var(--ease-default) backwards;
                }

                ul{
                    animation-delay: 100ms;
                }

                div{
                    animation-delay: 150ms;
                }

                address{
                    animation-delay: 200ms;
                }

            }
        }

    }

    // displaying desktop menu on desktop and hiding mobile menu on desktop
    @media only screen and (min-width: $tablet) {
        nav#main-menu{
            // display: flex;
            grid-template-columns: 1fr auto auto 1fr;
            align-items: center;

            ul{
                display: flex;
                justify-self: center;
                grid-column: 2/4;
                gap: var(--space-3xs);

                & li{
                    display: inline-block;
                }
            }
    
            & > :global(a:last-of-type){
                display: initial;
                justify-self: right;
            }

            button{
                display:none;
            }
        }
        
        dialog{
            display:none;
        }


    }

    @media only screen and (min-width: $laptop) {
        nav#main-menu{
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            justify-content: unset;

            ul{
                grid-column: 2/6;
                gap: var(--space-l);
            }
        }
    }
</style>

<nav aria-label="Main navigation menu" class="grid" id="main-menu">
    <Link href="/" label="Mattia Bombelli" active={currentPage === '/'} />
    
    <ul>
        {mainNavLinks.map((link) => (
            <li>
                <Link href={link.href} label={link.label} theme={link.theme} activeTheme={link.theme} active={currentPage === link.href} showActiveTheme pill/>
            </li>
        ))}
    </ul>

    <Link href="mailto:hello@mattiabombelli.com" label="Contact" />

    <button
        id="button-open"
        type="button"
        aria-controls="dialog-menu"
        aria-expanded="false"
        aria-label="Open main navigation menu"
        aria-haspopup="dialog"
        data-theme="mustard"
        data-hover="meadow"
        class="hamburger"
    >
        <Icon
            icon="hamburger"
            scale="h5"
            aria-hidden="true"
        />
    </button>

</nav>
<dialog
    id="dialog-menu"
    aria-label="Main navigation menu"
    data-theme="meadow"
>
    <div class="grid header">
        <Link href="/" label="Mattia Bombelli" class="no-hover" active={currentPage === '/'} />

        <button
            id="button-close"
            type="button"
            aria-label="Close menu"
            class="hamburger"
            data-hover="default"
        >   
            <Icon
                icon="x"
                scale="h5"
                aria-hidden="true"
            />
        </button>
    </div>
    
    <nav
        aria-label="Main navigation menu"
    >
        <ul data-theme="default">
            {mainNavLinks.map((link) => (
                <li>
                    <Link href={link.href} label={link.label} theme={link.theme} class="h5" active={currentPage === link.href} showActiveTheme />
                </li>
            ))}
        </ul>

        <div data-theme="default">
            <Link href="mailto:hello@mattiabombelli.com" label="Contact" class="h5"/>
        </div>
        <address class="h6 serif">hello@mattiabombelli.com</address>
    </nav>
</dialog>
<noscript>
    <style>
        @media only screen and (max-width: 767px){
            nav#main-menu {
                display: flex !important; 
                flex-direction: column;
                align-items: flex-start;
                gap: var(--space-m);
            }
    
            nav#main-menu ul {
                display: flex !important;
                flex-direction: column;
                align-items: center;
                gap: var(--gap-y-small);
            }
    
            nav#main-menu > a:last-of-type {
                display: block !important;
            }
    
            nav#main-menu button.hamburger {
                display: none !important;
            }
    
            dialog {
                display: none !important;
            }
        }
    </style>
</noscript>

<script>
    import { focusWithoutRing } from '@utils/focusWithoutRing';

    const menu = document.getElementById("dialog-menu");
    const buttonOpen = document.getElementById("button-open");
    const buttonClose = document.getElementById("button-close");

    if (menu instanceof HTMLDialogElement &&
        buttonOpen instanceof HTMLButtonElement &&
        buttonClose instanceof HTMLButtonElement
    ) {

        const setExpanded = (value: boolean) => buttonOpen.setAttribute('aria-expanded', value ? 'true' : 'false');

        buttonOpen.addEventListener("click", () => {
            menu.showModal();
            focusWithoutRing(buttonClose);
            setExpanded(true);
        });

        buttonClose.addEventListener("click", () => {
            menu.close();
        });

        menu.addEventListener('close', () => {
            setExpanded(false);
            focusWithoutRing(buttonOpen);
        })
    }
</script>