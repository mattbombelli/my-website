---
import '@style/global.scss';

export interface Props{
    hyperlink: string;
    label: string;
    type: 'page' | 'chapter' | 'subchapter';
    current?: boolean;
    id?: string;
}

const {
    hyperlink,
    label,
    type = 'chapter',
    current,
    ...rest
} = Astro.props;
---
<style lang="scss">
    @use '../../../foundations' as *;

    .toc{
        position: relative;
        color: var(--foreground);
        font-family: var(--font-sans-serif);
        transition: unset;
        text-decoration: none;
        display: block;
        padding: var(--space-xs) 0;

        &:visited {
        color: var(--foreground);
        }

        &:focus-visible {
            text-decoration: underline;
            text-decoration-thickness: 0.12em;
            text-underline-offset: .2em;
        }

        @media (hover: hover) and (pointer: fine) {
            transition: color var(--duration-default) var(--ease-default);

            &:hover {
                text-decoration: underline;
                text-decoration-thickness: 0.12em;
                text-underline-offset: .2em;
            }
        }

        &.page {
            @include heading('h5', 500);
            &:focus-visible {
                outline: none;
                box-shadow: none;
            }
        }
        &.chapter { @include heading('h6', 500); }

        &.subchapter {
            @include body-text('p', 400, 'sans-serif');
            padding-left: var(--space-s);
            border-left: .15em solid var(--paper-dark);
        }
        
        &.active{
            color: var(--cobalt-base);

            &:hover{
                color: var(--cobalt-base);    
            }

            &.subchapter{
                border-left-color: var(--cobalt-base);
            }

            &::after{
                position: absolute;
                content: '';
                width: var(--space-3xs);
                height: var(--space-3xs);
                border-radius: var(--radius-pill);
                background: var(--cobalt-base);
                top: 50%;
                transform: translateY(-50%);
                right: 0;
            }
        }
    }

    @media only screen and (min-width: $laptop) {
        .toc {
            &.page { @include heading('h6', 500); }

            &.chapter { @include body-text('p', 700, 'sans-serif'); }

            &.subchapter {
                @include body-text('small', 400, 'sans-serif');
                padding-left: var(--space-xs);
                border-left: .15em solid var(--paper-dark);

                &:focus-visible {
                    text-decoration: none;
                    border-left-color: var(--ink-light);
                }

                @media (hover: hover) and (pointer: fine) {
                    transition: border-left var(--duration-default) var(--ease-default),
                                background-color var(--duration-default) var(--ease-default);

                    &:hover {
                        text-decoration: none;
                        border-left-color: var(--ink-light);
                    }
                }
            }

            @media (hover: hover) and (pointer: fine) {
                &:hover {
                    color: var(--ink-light);
                }
            }

            &.active{
                color: var(--cobalt-base);

                &:hover{
                    color: var(--cobalt-base); 
                }

                &.subchapter{
                    border-left-color: var(--cobalt-base);
                }
            }
        }
    } // laptop

</style>
<a
    href={hyperlink}
    class:list={[type, "toc"]}
    {...rest}
    aria-current={current ? 'location' : undefined}
>
    {label}
</a>