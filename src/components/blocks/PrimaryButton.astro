---
import { propsToFilename } from 'astro/assets';
import '../../styles/global.scss';

import Button from '../primitives/Button.astro';
import type { Props as ButtonProps } from '../primitives/Button.astro';

import Shape from '../primitives/Shape.astro';
import type { Props as ShapeProps } from '../primitives/Shape.astro';

import Icon from '../primitives/Icon.astro';
import type { Props as IconProps } from '../primitives/Icon.astro';

export interface Props{
    // <a> element's own 
    href: string;
    cta?: boolean;
    
    button: ButtonProps;
    shape: ShapeProps;
    icon: IconProps;
}

const{
    href,
    button,
    shape,
    icon,
} = Astro.props;

---
<style lang="scss">
    @use '../../foundations' as *;

    .primary-button{
        display: inline-flex;
        text-decoration:none;
    }

    @media only screen and (min-width: $tablet){
        .primary-button{
            max-height: 120px;
            overflow-y: hidden;

            .decoration{
                height: 100%;
                translate: 0 0;
                display: flex;
                flex-direction: column;
                transition: translate var(--duration-slow) var(--ease-press);

                span{
                    display:inline-grid;
                    place-items: center;
                    border-radius: var(--radius-pill);
                    padding:var(--space-m);
                    background: var(--background);
                    :global(svg){
                        height:100%;
                    }
                    transform: scale(.4);
                    transform-origin: center top;
                    transition: transform var(--duration-slow) var(--ease-press);
                }
            }

            &:hover{
                .decoration{
                    translate: 0 -50%;

                    span{
                        transform: scale(1);
                    }
                }
            }
        }
    }
</style>
<a 
    href={href}
    class="primary-button"
>
    <Button 
        {...button}
        />
    <div class="decoration">
        <Shape 
        {...shape}
        />
        <span
            data-theme={icon.fill}
            data-theme-mode={icon.mode}
        >
            <Icon 
            {...icon}
            />
        </span>
    </div>
</a>