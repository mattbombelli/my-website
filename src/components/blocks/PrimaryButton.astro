---
import '../../styles/global.scss';

import Shape from '../primitives/Shape.astro';
import type { Props as ShapeProps } from '../primitives/Shape.astro';

import Icon from '../primitives/Icon.astro';
import type { Props as IconProps } from '../primitives/Icon.astro';

export interface Props{
    // <a> element's own 
    href: string;
    label: string;
    cta?: boolean;
    theme: string;
    themeMode?: 'normal' | 'invert';
    hover: string;
    hoverMode?: 'normal' | 'invert';
    border?: boolean;
    noDecoration?: boolean;

    // decorations
    shape: ShapeProps;
    icon: IconProps;
}

const{
    href,
    label,
    cta = false,
    theme = "default",
    themeMode = "normal",
    hover = "default",
    hoverMode = "normal",
    border = false,
    noDecoration = false,

    shape,
    icon,
} = Astro.props;

---
<style lang="scss">
    @use '../../foundations' as *;

    .primary-button{
        --a-height: var(--space-3xl);
        display: inline-flex;
        text-decoration:none;

        span.button{
            --type-button-size: var(--text-h6);
            --padding-inline-button: var(--space-m);
            --padding-block-button: var(--space-m);

            @media only screen and (min-width: $tablet){
                --type-button-size: var(--text-h5);
                --padding-inline-button: var(--space-l);
            }

            display: flex;
            align-items: center;
            font-size: var(--type-button-size);
            text-transform: uppercase;
            font-weight: 500;
            background: var(--background);
            color: var(--foreground);
            padding: var(--padding-block-button) var(--padding-inline-button);
            border-radius: var(--radius-pill);
            border: none;
            @media(prefers-reduced-motion: no-preference){
                transition: background var(--duration-slow) var(--ease-press),
                            color var(--duration-slow) var(--ease-press);
            }

            &.border{
                border: 4px solid var(--foreground);
            }
        }

        .decoration{
            display:none;
        }
    }

    @media only screen and (min-width: $tablet){
        .primary-button{
            max-height: var(--a-height);
            overflow-y: hidden;
            
            &.no-decoration{
                .decoration{
                    display:none;
                    opacity: 0;
                    visibility: hidden;
                }
            }
            
            &.cta{
                
            }
            
            .decoration{
                height: 50%;
                translate: 0 0;
                display: flex;
                flex-direction: column;
                @media(prefers-reduced-motion: no-preference){
                    transition: translate var(--duration-slow) var(--ease-press);
                }

                :global(svg), span{
                    height: var(--a-height);
                }

                span{
                    display:inline-grid;
                    place-items: center;
                    border-radius: var(--radius-pill);
                    padding:var(--space-m);
                    background: var(--background);
                    :global(svg){
                        height:100%;
                    }
                    transform: scale(.4);
                    transform-origin: center top;
                    @media(prefers-reduced-motion: no-preference){
                        transition: transform var(--duration-slow) var(--ease-press);
                    }
                }
            }

            
            &:hover,
            &:focus-visible{
                .decoration{
                    translate: 0 -50%;

                    span{
                        transform: scale(1);
                    }
                }
            }
        } // .primary-button
    } // $tablet
</style>
<a 
    href={href}
    class:list={[
        "primary-button",
        {cta: cta},
        {"no-decoration": noDecoration}
    ]}
    data-hover={hover}
    data-hover-mode={hoverMode}
    data-theme={theme}
    data-theme-mode={themeMode}
>

    <span
        class:list={[
            "sans-serif button",
            {border: border}
        ]}
    >
        {label}
    </span>
    <div 
        class="decoration"
        aria-hidden="true"
    >
        <Shape 
        {...shape}
        />
        <span
            data-theme={icon.fill}
            data-theme-mode={icon.themeMode}
        >
            <Icon 
            {...icon}
            />
        </span>
    </div>
</a>