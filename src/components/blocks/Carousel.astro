---
import '@style/global.scss';
import Figure from '@primitives/Figure.astro';
import Icon from '@primitives/Icon.astro';
import { resolveImage } from '../../utils/resolveImage';

export interface Props{
    slides: {
        src: string;
        alt: string;
        caption?: string;
        desktop?: {
            columnSpan: string;
            columnOffset: string;
            rowSpan: string;
            rowOffset: string;
        };
        tablet?: {
            columnSpan: string;
            columnOffset: string;
            rowSpan: string;
            rowOffset: string;
        };
    }[];
    ariaLabel: string;
    id: string;
}

const {
    slides,
    ariaLabel,
    id
} = Astro.props;

const resolvedSlides = await Promise.all(
    slides.map(async (slide) => ({
        ...slide,
        resolvedSrc: await resolveImage(slide.src),
    }))
);

const showDots = slides.length <= 7;
---

<style lang="scss">
    @use '../../foundations' as *;

    :global(.js-carousel-ready) {
        .carousel{
            :global(figure figcaption){
                margin-top: calc( var(--controls-height, 3rem) + var(--space-xs, .5rem) * 2 );
            }
        }

        .carousel__controls{
            position: absolute;
            width: 100%;
            top: calc( var(--controls-offset, 2rem) + var(--space-xs, .5rem));
            left: 50%;
            transform: translateX(-50%);
        } 
    } // js-carousel-ready

    @media only screen and (max-width: $tablet - 1px){
        .carousel:not(.carousel--ready){
            .carousel__viewport,
            .carousel__controls{
                visibility: hidden;
            }
        }
    }

    .carousel__skeleton{
        position: absolute;
        inset: 0;
        z-index: 1;

        display: flex;
        flex-direction: column;
        gap: var(--space-xs);

        &[hidden]{
            display: none;
        }

        &-image{
            display: block;
            background-color: var(--paper-dark);
            background-image: var(--blurhash-gradient);
        }

        &-controls{
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--padding-inline);

            .skeleton-circle{
                display: block;
                width: calc(var(--text-h5) + var(--space-xs) * 2);
                height: calc(var(--text-h5) + var(--space-xs) * 2);
                border-radius: var(--radius-pill);
                background-color: var(--paper-dark);
            }
            
            .skeleton-pill{
                display: block;
                width: 40%;
                height: var(--space-s);
                border-radius: var(--radius-pill);
                background-color: var(--paper-dark);
            }
        }

        &-caption{
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 0 var(--padding-inline);
            gap: calc(var(--text-p) * (var(--leading-serif-p) - 1));
            margin-top: var(--space-xs);
            
            .skeleton-line{
                background-color: var(--paper-dark);
                display: block;
                border-radius: var(--radius-pill);
                height: calc(var(--text-p) * 0.65);
                width: 100%;

                &-short{
                    width: 40%;
                }
            }
        }
    } // skeleton

    .carousel {
        position: relative;
        grid-column: span 2;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);

        .carousel__viewport {
            height: var(--active-slide-height, auto);
            overflow: hidden;

            @media (prefers-reduced-motion: no-preference){
                transition: height var(--duration-default) var(--ease-default);
            }

            .carousel__container {
                display: flex;
                touch-action: pan-y pinch-zoom;
                align-items: flex-start;

                :global(.carousel__slide) {
                    flex: 0 0 100%;
                    min-width: 0;
                    height: auto;

                    :global(figcaption){
                        font-family: var(--font-serif);
                        font-size: var(--text-p);
                        line-height: var(--leading-serif-p);
                        font-style: italic;
                    }
                } // slide
            } // container
        } // viewport

        .carousel__controls{
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--padding-inline);

            .carousel__control{
                padding: var(--space-xs);
                background:none;
                border:none;
                border-radius: var(--radius-pill);
                display: flex;
                cursor: pointer;

                :global(svg){
                    height: var(--text-h5);
                    transition: opacity var(--duration-default) var(--ease-default);

                    :global(path){
                        fill:var(--foreground);
                    }
                }

                &[aria-disabled='true']{
                    cursor:not-allowed;
                    :global(svg){
                        opacity: .3;
                    }
                }

                &:not([aria-disabled='true']){
                    opacity: 1;

                    @media (hover: hover) and (pointer: fine){
                        transition: background var(--duration-default) var(--ease-default);
    
                        &:hover{
                            background: var(--paper-dark);
                        }
                    }
                }

            } // individual control

            div[role="group"]{
                display: none;
                justify-content: space-between;
                gap: var(--space-3xs);
                flex-shrink: 0;
                
                @media only screen and (min-width: $mobile){
                    display: flex;
                }
                
                &[hidden]{
                    display: none;
                }

                button{
                    background: none;
                    border: none;
                    padding: var(--space-2xs);
                    border-radius: var(--radius-pill);
                    display: flex;
                    flex-shrink: 0;
                    cursor: pointer;

                    span{
                        display: inline-block;
                        background: var(--background);
                        aspect-ratio: 1/1;
                        border: .2em solid var(--foreground);
                        border-radius: var(--radius-pill);
                        height: var(--space-s);
                        transition: background var(--duration-default) var(--ease-default);
                    }

                    @media (hover: hover) and (pointer: fine){
                        &:hover{
                            span{
                                background: var(--ink-light);
                            }
                        }
                    }

                    &[aria-current='true']{
                        span{
                            background: var(--foreground);
                        }
                    }
                }
            } //div[role="group"]

        } // carousel controls
    } // carousel

    @media only screen and (min-width: $tablet){
        .carousel{
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: subgrid;

            .carousel__skeleton{
                display: none;
            }    

            .carousel__viewport {
                overflow: unset;
                grid-column: 1 / -1;
                display: grid;
                grid-template-columns: subgrid;
                height: auto;

                .carousel__container {
                    touch-action: unset;
                    display: grid;
                    grid-column: 1 / -1;
                    grid-template-columns: subgrid;
                    align-items: initial;
                    row-gap: var(--custom-row-gap);

                    :global(figure){
                        grid-column: var(--offset-tablet, 2) / span var(--span-tablet, 2);
                        grid-row: var(--row-offset-tablet, auto) / var(--row-span-tablet, auto);

                        display: flex;
                        flex-direction: column;

                        :global(figcaption){
                            margin-top: var(--space-s);
                        }
                    }
                }
            }
            
            .carousel__controls{
                display: none;
            }
        }
        

    } // $tablet
    

    @media only screen and (min-width: $laptop){
        .carousel{
            .carousel__viewport{
                .carousel__container{
                    :global(figure){
                        grid-column: var(--offset-default, 2) / span var(--span-default, 2);
                        grid-row: var(--row-offset-default, auto) / var(--row-span-default, auto);
                    }
                }
            }
        }            
    }
</style>

<div
    class="carousel"
    id={id}
    aria-label={ariaLabel}
    aria-roledescription="carousel"
>
    <div
        class="carousel__viewport"
        role="presentation"
    >
        <div
            class="carousel__container"
        >
            {resolvedSlides.map((slide, i) => (
                <Figure
                    class="carousel__slide"
                    id={`${id}-slide-${i}`}
                    src={slide.resolvedSrc}
                    alt={slide.alt}
                    caption={slide.caption}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`Slide ${i + 1} of ${slides.length}`}
                    
                    style={`
                        --span-default: ${slide.desktop?.columnSpan};
                        --offset-default: ${slide.desktop?.columnOffset};
                        --span-tablet: ${slide.tablet?.columnSpan};
                        --offset-tablet: ${slide.tablet?.columnOffset};

                        --row-span-default: ${slide.desktop?.rowSpan === 'auto' ? 'auto' : `span ${slide.desktop?.rowSpan}`};
                        --row-offset-default: ${slide.desktop?.rowOffset};
                        --row-span-tablet: ${slide.tablet?.rowSpan === 'auto' ? 'auto' : `span ${slide.tablet?.rowSpan}`};
                        --row-offset-tablet: ${slide.tablet?.rowOffset};

                        --blurhash-gradient: ${slide.resolvedSrc.placeholder};
                    `}
                />
            ))}
        </div> <!-- container -->
    </div> <!-- viewport -->
    <div
        class="carousel__controls"
        role="group"
        aria-label="Slide controls"
    >
        <button
            class="carousel__control carousel__prev"
            aria-label="Previous"
            aria-disabled="true"
        >
            <Icon icon="arrowLeft" aria-hidden="true" />
        </button>
        <div
            role="group"
            aria-label="Choose slide to display"
            hidden={!showDots}
        >
            {slides.map((_, i) => (
                <button
                    aria-label={`Slide ${i + 1} of ${slides.length}`}
                    aria-current={i === 0}
                    aria-controls={`${id}-slide-${i}`}
                >
                    <span />
                </button>
            ))}
        </div>
        <span
            class:list={[
                "carousel__counter",
                "carousel__status",
                "sans-serif",
                { 'visually-hidden': showDots }
            ]}
            aria-live="polite"
            aria-atomic="true"
        >
            1 / {slides.length}
        </span>
        <button
            class="carousel__control carousel__next"
            aria-label="Next"
        >
            <Icon icon="arrowRight" aria-hidden="true" />
        </button>
    </div> <!-- controls -->
    <div
        class="carousel__skeleton"
        aria-hidden="true"
        >
        <div
            class="carousel__skeleton-image"
            style={`aspect-ratio: ${resolvedSlides[0].resolvedSrc.width} / ${resolvedSlides[0].resolvedSrc.height}`}
        ></div>
        <div class="carousel__skeleton-controls">
            <span class="skeleton-circle"></span>
            <span class="skeleton-pill"></span>
            <span class="skeleton-circle"></span>
        </div>
        <div class="carousel__skeleton-caption">
            <span class="skeleton-line"></span>
            <span class="skeleton-line skeleton-line-short"></span>
        </div>
    </div> <!-- skeleton -->

    <noscript>
        <style lang="scss">
            .carousel__viewport {
                visibility: visible !important;
                overflow: visible !important;
                height: auto !important;
            }

            .carousel__container {
                display: grid !important;
                gap: var(--gap-y) !important;
            }

            figure.carousel__slide {
                flex: 0 0 auto !important;
            }

            figure.carousel__slide figcaption {
                margin-top: var(--space-s) !important;
            }

            .carousel__controls {
                display: none !important;
            }
            .carousel__skeleton {
                display: none !important;
            }
        </style>
    </noscript>
</div> <!-- carousel -->

<script>
    import EmblaCarousel from 'embla-carousel';

    document.body.classList.add('js-carousel-ready');

    const carousels = Array.from(document.querySelectorAll('.carousel')) as HTMLElement[];

    carousels.forEach(wrapper => {
        const viewport = wrapper.querySelector('.carousel__viewport') as HTMLElement;
        const prevBtn = wrapper.querySelector('.carousel__prev') as HTMLElement;
        const nextBtn = wrapper.querySelector('.carousel__next') as HTMLElement;

        let embla: any = null;
        const observers: ResizeObserver[] = [];
        let controller: AbortController | null = null;

        const mql = window.matchMedia('(max-width: 767px)');

        // Generic helper: observe an element, run a callback with its measured
        // size on every change (and once immediately, synchronously, to avoid
        // a first-frame gap before the observer's async callback fires).
        const observeSize = (
            el: HTMLElement,
            onResize: (rect: DOMRectReadOnly) => void
        ) => {
            onResize(el.getBoundingClientRect());

            const ro = new ResizeObserver(([entry]) => {
                onResize(entry.contentRect);
            });
            ro.observe(el);
            observers.push(ro);

            return ro;
        };

        const init = () => {
            if (!mql.matches || embla) return;

            controller = new AbortController();
            const { signal } = controller;

            embla = EmblaCarousel(viewport, { loop: false });

            prevBtn.addEventListener('click', () => {
                if (prevBtn.getAttribute('aria-disabled') === 'true') return;
                embla.scrollPrev();
            }, { signal });
            nextBtn.addEventListener('click', () => {
                if (nextBtn.getAttribute('aria-disabled') === 'true') return;
                embla.scrollNext();
            }, { signal });

            const controls = wrapper.querySelector('.carousel__controls') as HTMLElement;
            const tablist = controls.querySelector('[role="group"]') as HTMLElement;
            const counter = controls.querySelector('.carousel__counter') as HTMLElement;
            const dots = Array.from(tablist.querySelectorAll('button')) as HTMLElement[];
            const slideElements = Array.from(wrapper.querySelectorAll('.carousel__slide')) as HTMLElement[];
            const skeleton = wrapper.querySelector('.carousel__skeleton') as HTMLElement;
            const firstImage = slideElements[0]?.querySelector('img') as HTMLElement | null;

            viewport.setAttribute('inert', '');
            controls.setAttribute('inert', '');

            if (skeleton && firstImage) {
                const hideSkeleton = () => {
                    skeleton.setAttribute('hidden', '');
                    viewport.removeAttribute('inert');
                    controls.removeAttribute('inert');
                    wrapper.classList.add('carousel--ready');
                };

                if ((firstImage as HTMLImageElement).complete) {
                    hideSkeleton();
                } else {
                    firstImage.addEventListener('load', hideSkeleton, { once: true, signal });
                }
            }


            // --- Controls height -> reserved gap above figcaption ---
            observeSize(controls, (rect) => {
                wrapper.style.setProperty('--controls-height', `${rect.height}px`);
            });

            // --- First image height -> controls vertical offset ---
            if (firstImage) {
                observeSize(firstImage, (rect) => {
                    wrapper.style.setProperty('--controls-offset', `${rect.height}px`);
                });
            }

            // --- Dots vs. counter fit check ---
            const tablistFits = () => {
                const wasHidden = tablist.hasAttribute('hidden');
                if (wasHidden) tablist.style.display = 'flex';

                const fits = controls.scrollWidth <= controls.clientWidth;

                if (wasHidden) tablist.style.display = '';

                return fits;
            };

            const updateDotsVisibility = () => {
                const shouldShowDots = tablistFits();
                const isDotsCurrentlyHidden = tablist.hasAttribute('hidden');

                if (shouldShowDots === isDotsCurrentlyHidden) {
                    if (shouldShowDots) {
                        tablist.removeAttribute('hidden');
                        counter.classList.add('visually-hidden');
                    } else {
                        tablist.setAttribute('hidden', '');
                        counter.classList.remove('visually-hidden');
                    }
                }
            };

            updateDotsVisibility();
            observeSize(controls, updateDotsVisibility);

            // --- Keyboard nav ---
            tablist.addEventListener('keydown', (e) => {
                const current = embla.selectedScrollSnap();

                if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    const next = current + 1;
                    if (next < slideElements.length) {
                        embla.scrollTo(next);
                        dots[next].focus();
                    }
                }

                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    const prev = current - 1;
                    if (prev >= 0) {
                        embla.scrollTo(prev);
                        dots[prev].focus();
                    }
                }
            }, { signal });

            // --- ARIA sync ---
            const updateARIA = () => {
                const current = embla.selectedScrollSnap();

                prevBtn.setAttribute('aria-disabled', String(!embla.canScrollPrev()));
                nextBtn.setAttribute('aria-disabled', String(!embla.canScrollNext()));

                dots.forEach((dot, i) => {
                    dot.setAttribute('aria-current', String(i === current));
                    dot.setAttribute('tabindex', i === current ? '0' : '-1');
                });

                counter.textContent = `${current + 1} / ${slideElements.length}`;

                slideElements.forEach((slide, i) => {
                    if (i === current) {
                        slide.removeAttribute('inert');
                    } else {
                        slide.setAttribute('inert', '');
                    }
                });
            };

            const setActiveSlideHeight = () => {
                const current = embla.selectedScrollSnap();
                const activeSlide = slideElements[current];

                if (activeSlide) {
                    wrapper.style.setProperty('--active-slide-height', `${activeSlide.getBoundingClientRect().height}px`);
                }
            };

            dots.forEach((dot, i) => {
                dot.addEventListener('click', () => {
                    embla.scrollTo(i);
                    dots[i].focus();
                }, { signal });
            });

            embla.on('select', () => {
                updateARIA();
                setActiveSlideHeight();
            });

            updateARIA();
            observeSize(viewport, () => {
                setActiveSlideHeight();
            });
        }; // init

        const destroy = () => {
            if (embla) {
                const slideElements = Array.from(wrapper.querySelectorAll('.carousel__slide')) as HTMLElement[];
                slideElements.forEach(slide => {
                    slide.removeAttribute('inert');
                });
                embla.destroy();
                embla = null;
            }

            controller?.abort();
            controller = null;

            observers.forEach(ro => ro.disconnect());
            observers.length = 0;

            const controls = wrapper.querySelector('.carousel__controls') as HTMLElement;
            const skeleton = wrapper.querySelector('.carousel__skeleton') as HTMLElement;

            if (skeleton) {
                skeleton.removeAttribute('hidden');
                viewport.removeAttribute('inert');
                controls.removeAttribute('inert');
                wrapper.classList.remove('carousel--ready');
            }
        }; // destroy

        mql.addEventListener('change', (e) => {
            e.matches ? init() : destroy();
        });

        init();
    });
</script>