---
import '@style/global.scss';
import Figure from '@primitives/Figure.astro';
import Icon from '@primitives/Icon.astro';
import { resolveImage } from '../../utils/resolveImage';

export interface Props{
    slides: {
        src: string;
        alt: string;
        caption?: string;
        desktop?: {
            columnSpan: string;
            columnOffset: string;
            rowSpan: string;
            rowOffset: string;
        };
        tablet?: {
            columnSpan: string;
            columnOffset: string;
            rowSpan: string;
            rowOffset: string;
        };
    }[];
    ariaLabel: string;
    id: string;
}

const {
    slides,
    ariaLabel,
    id
} = Astro.props;

const resolvedSlides = await Promise.all(
    slides.map(async (slide) => ({
        ...slide,
        resolvedSrc: await resolveImage(slide.src),
    }))
);

const showDots = slides.length <= 7;
---

<style lang="scss">
    @use '../../foundations' as *;

    .carousel {
        grid-column: span 2;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);

        .carousel__viewport {
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: var(--gap-y-small);

            .carousel__container {
                display: flex;
                touch-action: pan-y pinch-zoom;

                :global(.carousel__slide) {
                    flex: 0 0 100%;
                    min-width: 0;
                    height: 100%;

                    :global(figcaption){
                        font-family: var(--font-serif);
                        font-size: var(--text-p);
                        line-height: var(--leading-serif-p);
                        font-style: italic;

                        position: absolute;
                        width: 1px;
                        height: 1px;
                        overflow: hidden;
                        clip: rect(0,0,0,0);
                        white-space: nowrap;
                    }
                } //slide

            } // container

            .carousel__controls{
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 var(--padding-inline);

                .carousel__control{
                    padding: var(--space-xs);
                    background:none;
                    border:none;
                    border-radius: var(--radius-pill);
                    display: flex;

                    :global(svg){
                        height: var(--text-h5);
                        transition: opacity var(--duration-default) var(--ease-default);

                        :global(path){
                            fill:var(--foreground);
                        }
                    }

                    &[aria-disabled='true']{
                        :global(svg){
                            opacity: .3;
                        }
                    }

                    &:not([aria-disabled='true']){
                        opacity: 1;

                        @media (hover: hover) and (pointer: fine){
                            transition: background var(--duration-default) var(--ease-default);
        
                            &:hover{
                                background: var(--paper-dark);
                            }
                        }
                    }

                }

                div[role="tablist"]{
                    display: none;
                    justify-content: space-between;
                    gap: var(--space-3xs);

                    
                    @media only screen and (min-width: $mobile){
                        display: flex;
                    }
                    
                    &[hidden]{
                        display: none;
                    }

                    button{
                        background: none;
                        border: none;
                        padding: var(--space-2xs);
                        border-radius: var(--radius-pill);
                        display: flex;

                        span{
                            display: inline-block;
                            background: var(--background);
                            aspect-ratio: 1/1;
                            border: .2em solid var(--foreground);
                            border-radius: var(--radius-pill);
                            height: var(--space-s);
                            transition: background var(--duration-default) var(--ease-default);
                        }

                        @media (hover: hover) and (pointer: fine){
                            &:hover{
                                span{
                                    background: var(--ink-light);
                                }
                            }
                        }

                        &[aria-selected='true']{
                            span{
                                background: var(--foreground);
                            }
                        }
                    }
                }

            } // carousel controls
            p.carousel__caption{
                padding: 0 var(--padding-inline);
            }
        } // viewport
    } // carousel

    @media only screen and (min-width: $tablet){
        .carousel{
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: subgrid;

            .carousel__viewport {
                overflow: unset;
                grid-column: 1 / -1;
                display: grid;
                grid-template-columns: subgrid;
                gap: unset;

                .carousel__container {
                    touch-action: unset;
                    display: grid;
                    grid-column: 1 / -1;
                    grid-template-columns: subgrid;
                    row-gap: var(--custom-row-gap);

                    :global(.carousel__slide){
                        grid-column: var(--offset-tablet, 2) / span var(--span-tablet, 2);
                        grid-row: var(--row-offset-tablet, auto) / var(--row-span-tablet, auto);

                        display: flex;
                        flex-direction: column;

                        :global(figcaption){
                            width:initial;
                            height: initial;
                            position: initial;
                            clip: unset;
                            overflow: unset;
                            white-space: initial;
                        }
                    }
                } // container

                .carousel__controls{
                    display: none;
                }

                .carousel__caption{
                    display: none;
                }
            } // viewport

        } // carousel

    } // $tablet

    @media only screen and (min-width: $laptop){
        .carousel{
            .carousel__viewport{
                .carousel__container{
                    :global(figure.carousel__slide){
                        grid-column: var(--offset-default, 2) / span var(--span-default, 2);
                        grid-row: var(--row-offset-default, auto) / var(--row-span-default, auto);
                    }
                }
            }
        }            
    }
</style>

<section
    class="carousel"
    id={id}
    aria-label={ariaLabel}
    aria-roledescription="carousel"
>
    <div
        class="carousel__viewport"
        role="presentation"
    >
        <div
            class="carousel__container"
            aria-live="polite"
        >
            {resolvedSlides.map((slide, i) => (
                <Figure
                    class="carousel__slide"
                    id={`${id}-slide-${i}`}
                    src={slide.resolvedSrc}
                    alt={slide.alt}
                    caption={slide.caption}
                    role="tabpanel"
                    aria-label={`Slide ${i + 1} of ${slides.length}`}
                    
                    style={`
                        --span-default: ${slide.desktop?.columnSpan};
                        --offset-default: ${slide.desktop?.columnOffset};
                        --span-tablet: ${slide.tablet?.columnSpan};
                        --offset-tablet: ${slide.tablet?.columnOffset};

                        --row-span-default: ${slide.desktop?.rowSpan === 'auto' ? 'auto' : `span ${slide.desktop?.rowSpan}`};
                        --row-offset-default: ${slide.desktop?.rowOffset};
                        --row-span-tablet: ${slide.tablet?.rowSpan === 'auto' ? 'auto' : `span ${slide.tablet?.rowSpan}`};
                        --row-offset-tablet: ${slide.tablet?.rowOffset};
                    `}
                />
            ))}

        </div> <!-- container -->
        <div
            class="carousel__controls"
            role="group"
            aria-label="Slide controls"
        >
            <button
                class="carousel__control carousel__prev"
                aria-label="Previous"
                aria-disabled="true"
            >
                <Icon icon="arrowLeft" aria-hidden="true" />
            </button>
            <div
                role="tablist"
                aria-label="Choose slide to display"
                hidden={!showDots}
            >
                {slides.map((_, i) => (
                    <button
                        role="tab"
                        aria-label={`Slide ${i + 1} of ${slides.length}`}
                        aria-selected={i === 0}
                        aria-controls={`${id}-slide-${i}`}
                    >
                        <span />
                    </button>
                ))}
            </div>
            <span
                class="carousel__counter sans-serif"
                aria-live="polite"
                aria-atomic="true"
                hidden={showDots}
            >
                1 / {slides.length}
            </span>
            <button
                class="carousel__control carousel__next"
                aria-label="Next"
            >
                <Icon icon="arrowRight" aria-hidden="true" />
            </button>
        </div> <!-- controls -->
        <p
            class="carousel__caption italic"
            aria-hidden="true"
        >
        </p>
    </div> <!-- viewport -->
</section> <!-- carousel -->

<script>
    import EmblaCarousel from 'embla-carousel';

    const carousels = document.querySelectorAll<HTMLElement>('.carousel');

    carousels.forEach(wrapper => {
        const viewport = wrapper.querySelector('.carousel__viewport') as HTMLElement;
        const prevBtn = wrapper.querySelector('.carousel__prev') as HTMLElement;
        const nextBtn = wrapper.querySelector('.carousel__next') as HTMLElement;

        let embla: any = null;

        const mql = window.matchMedia('(max-width: 767px)');

        const init = () => {
            if (mql.matches && !embla) {
                embla = EmblaCarousel(viewport, { loop: false });

                prevBtn.addEventListener('click', () => {
                    if (prevBtn.getAttribute('aria-disabled') === 'true') return;
                    embla.scrollPrev();
                }, false);
                nextBtn.addEventListener('click', () => {
                    if (nextBtn.getAttribute('aria-disabled') === 'true') return;
                    embla.scrollNext();
                }, false);

                const tablist = wrapper.querySelector('[role="tablist"]') as HTMLElement;
                const counter = wrapper.querySelector('.carousel__counter') as HTMLElement;
                const dots = Array.from(tablist.querySelectorAll('[role="tab"]')) as HTMLElement[];
                const slides = Array.from(wrapper.querySelectorAll('.carousel__slide')) as HTMLElement[];
                const MAX_DOTS = 7;

                console.log("Number of slides:", slides.length);

                if (slides.length > MAX_DOTS) {
                    tablist.setAttribute('hidden', '');
                    counter.removeAttribute('hidden');
                } else {
                    tablist.removeAttribute('hidden');
                    counter.setAttribute('hidden', '');

                    tablist.addEventListener('keydown', (e) => {
                        const current = embla.selectedScrollSnap();
    
                        if (e.key === 'ArrowRight') {
                            e.preventDefault();
                            const next = current + 1;
                            if (next < slides.length) {
                                embla.scrollTo(next);
                                dots[next].focus();
                            }
                        }
    
                        if (e.key === 'ArrowLeft') {
                            e.preventDefault();
                            const prev = current - 1;
                            if (prev >= 0) {
                                embla.scrollTo(prev);
                                dots[prev].focus();
                            }
                        }
                    });
                }


                const updateARIA = () => {
                    const current = embla.selectedScrollSnap();
                    const currentSlide = slides[current];
                    const figcaption = currentSlide.querySelector('figcaption') as HTMLElement;
                    const captionEl = wrapper.querySelector('.carousel__caption');
                    if (captionEl && figcaption) {
                        captionEl.textContent = figcaption.textContent;
                    }

                    prevBtn.setAttribute('aria-disabled', String(!embla.canScrollPrev()));
                    nextBtn.setAttribute('aria-disabled', String(!embla.canScrollNext()));
                    
                    dots.forEach((dot, i) => {
                        dot.setAttribute('aria-selected', String(i === current));
                        dot.setAttribute('tabindex', i === current ? '0' : '-1');
                    });

                    counter.textContent = `${current + 1} / ${slides.length}`;

                    slides.forEach((slide, i) => {
                        if ( i === current ){
                            slide.removeAttribute('aria-hidden');
                            slide.removeAttribute('inert');
                        } else {
                            slide.setAttribute('aria-hidden', 'true');
                            slide.setAttribute('inert', '');
                        }
                    });
                } // updateARIA

                dots.forEach((dot, i) => {
                    dot.addEventListener('click', () => {
                        embla.scrollTo(i);
                        dots[i].focus();
                    });
                });

                embla.on('select', updateARIA);

                updateARIA();
            }
        }; // init

        const destroy = () => {
            if (embla) {
                embla.destroy();
                embla = null;
            }
        }; // destroy

        mql.addEventListener('change', (e) => {
            e.matches ? init() : destroy();
        });

        init();
    });
</script>