---
import '../../styles/global.scss';

import Link from '../primitives/Link.astro';
import { footerNavLinks } from '../../data/navigation.ts';
---
<style lang="scss">
    footer{
        background: var(--background);
        color: var(--foreground);
        row-gap: var(--space-2xl);

        section{
            display:flex;
            flex-direction: column;
            gap: var(--space-l);

            grid-column: 1/3;

            h1, h2, h3{
                margin: 0;
            }

            ul{
                list-style-type: none;
                margin:0;
                padding:var(--space-l) 0;
                
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                column-gap: var(--gap-x);
                row-gap: var(--space-m);
            }

            &:nth-of-type(2){
                border-color: var(--foreground);
                border-style: solid;
                border-width: 1px 0 1px 0;

                :global(a){
                    width: 100%;
                }
            }

            &:last-of-type{
                text-align: center;
                gap: var(--space-s);
            }
        }
    }
</style>

<footer data-theme-mode="invert" class="grid">
    <section class="column">
        <h1 class="h2">Mattia Bombelli</h1>
        <h2 class="h4 serif italic">Your friendly neighbourhood UX designer</h2>
    </section>
    <section class="column">
        <ul role="list">
            {   footerNavLinks.map((link) => (
                <li>
                    <Link href={link.href} label={link.label} bg="dark"/>
                </li>
            ))}
        </ul>
    </section>
    <section class="column">
        <h3>Get in touch</h3>
        <Link href="mailto:hello@mattiabombelli.com" label="hello@mattiabombelli.com" class="italic serif" bg="dark"/>
    </section>
</footer>