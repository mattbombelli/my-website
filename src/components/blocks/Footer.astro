---
import '@style/global.scss';

import Link from '@primitives/Link.astro';
import { footerNavLinks } from '@data/navigation.ts';

const currentPage = Astro.url.pathname;
---
<style lang="scss">
    @use '../../foundations' as *;

    footer.grid{
        background: var(--background);
        color: var(--foreground);
        row-gap: var(--space-2xl);

        section{
            display:flex;
            flex-direction: column;
            gap: var(--space-l);

            grid-column: 1/3;

            h2, h3, h4{
                margin: 0;
                span{
                    display: block;
                }
            }

            h2{
                font-size: var(--text-h2);
                line-height: var(--leading-sans-serif-h2);
            }

            h3{
                font-size: var(--text-h4);
                line-height: var(--leading-serif-h4);
            }

            ul{
                list-style-type: none;
                margin:0;
                padding:var(--space-l) 0;
                
                // display: grid;
                display:flex;
                flex-direction: row;
                flex-wrap: wrap;
                // grid-template-columns: repeat(2, 1fr);
                column-gap: var(--gap-x);
                row-gap: var(--space-m);
                li{
                    flex: 1 1 calc(50% - var(--gap-x) / 2);

                    @media only screen and (max-width: $mobile){
                        li{
                            flex-basis: 100%;
                        }
                    }
                }
            }

            &:nth-of-type(2){
                border-color: var(--foreground);
                border-style: solid;
                border-width: 1px 0 1px 0;

                :global(a){
                    width: 100%;
                }
            }

            &:last-of-type{
                text-align: center;
                gap: var(--space-s);
            }
        }
    }

    @media only screen and (min-width: $tablet){
        footer.grid{
            row-gap: var(--space-xl);

            section{
                grid-column: 1/5;

                h2{
                    font-size: var(--text-h1);
                    line-height: var(--leading-sans-serif-h1);
                }

                h3{
                    font-size: var(--text-h3);
                    line-height: var(--leading-serif-h3);
                }
                
                ul{
                    flex-wrap: nowrap;
                    justify-content: space-around;
                    
                    li{
                        flex: initial;

                        :global(a){
                            padding: var(--space-xs) var(--space-s);
                        }
                    }
                }

                h4{
                    font-size: var(--text-h2);
                    line-height: var(--leading-sans-serif-h2);
                }
            }
        }
    }

    @media only screen and (min-width: $laptop){
        footer.grid{
            section{
                border-right: 1px solid var(--foreground);
                padding-right: var(--space-m);

                &:nth-of-type(1){
                    grid-column: 1/3;
                    padding-bottom: var(--space-6xl);
                }
                &:nth-of-type(2){
                    justify-content: flex-end;
                    border-width: 0 1px 0 0;
                    border-top: none;
                    border-bottom: none;
                    grid-column: 3/5;

                    ul{
                        padding: 0;
                        align-self: flex-end;
                        flex-direction: column;
                        text-align: right;

                        li{
                            :global(a){
                                padding: var(--space-xs) 0;
                            }
                        }
                    }
                }
                &:nth-of-type(3){
                    text-align: right;
                    justify-content: flex-end;
                    grid-column: 5/7;
                }
            }

        }
    }
</style>

<footer data-theme-mode="invert" class="grid">
    <section>
        <h2>
            <span>Mattia </span>
            <span>Bombelli</span>
        </h2>
        <h3 class="serif italic">
            <span>Your friendly</span>
            <span>neighbourhood</span>
            <span>UX designer</span>
        </h3>
    </section>
    <section>
        <ul>
            {   footerNavLinks.map((link) => (
                <li>
                    <Link href={link.href} label={link.label} active={currentPage === link.href} class="alt-hover"/>
                </li>
            ))}
        </ul>
    </section>
    <section>
        <h4>Get in touch</h4>
        <Link href="mailto:hello@mattiabombelli.com" label="hello@mattiabombelli.com" class="italic serif alt-hover" />
    </section>
</footer>