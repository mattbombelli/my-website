---
// src/components/blocks/TableOfContents.astro
import '@style/global.scss';
import ContentLink from '@blocks/parts/ContentLink.astro';
import Icon from '@primitives/Icon.astro';

export interface Props{
    page: string;
    pageLink: string;
    chapters: {
        type: 'h1' | 'h2' | 'h3',
        label: string,
        link: string
    }[];
    readingTime?: string;
}

interface Chapter {
    type: string;
    label: string;
    link: string;
}

interface GroupedChapter extends Chapter {
    children: Chapter[];
}

const {
    page,
    pageLink,
    chapters,
    readingTime,
} = Astro.props;

const grouped = chapters.reduce<GroupedChapter[]>((acc, chapter) => {
    if (chapter.type === 'h1') return acc;

    if (chapter.type === 'h2') {
        acc.push({ ...chapter, children:[] });
    } else if (acc.length > 0) {
        acc[acc.length - 1].children.push(chapter);
    }

    return acc;
}, []);
---
<style lang="scss">
    @use '../../foundations/' as *;

    .toc-wrapper{
        .pseudo-nav{
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1;
            align-items: center;
            padding-block: var(--space-2xs);
            background: var(--background);
            color: var(--foreground);
            visibility: hidden;
            transform: translateY(-100%);

            @media (prefers-reduced-motion: no-preference) {
                transition: transform var(--duration-default) var(--ease-default),
                            visibility 0s var(--duration-default);
            }

            &.visible {
                visibility: visible;
                transform: translateY(0);

                @media (prefers-reduced-motion: no-preference) {
                    transition: transform var(--duration-default) var(--ease-default),
                                visibility 0s;
                }
            }

            span{
                justify-self: left;
                @include body-text('p', 500, 'sans-serif');
            }

            button{
                justify-self: right;
            }
        }

        button{
            display: inline-grid;
            place-items: center;
            background-color: var(--background);
            border: none;
            border-radius: var(--radius-pill);
            padding: var(--space-xs);
            aspect-ratio: 1/1;
            cursor: pointer;
            transition: background-color var(--duration-default) var(--ease-default);
        }

        :global(body:has(dialog[open])){
            overflow: hidden;
        }

        #toc-dialog{
            background: var(--background);
            margin: 0;
            border: 0;
            height: 100dvh;
            width: 100%;
            max-width: none;
            max-height: none;
            padding: 0;

            &::backdrop{
                background: var(--background);
            }

            .toc-heading{
                padding: var(--space-m) var(--padding-inline);
                border-bottom: .12em solid var(--paper-dark);

                small{
                    @include body-text('p', 400, 'sans-serif');
                    display: block;
                }
            }

            .table-of-contents{
                ul{
                    padding: 0 var(--padding-inline);
                }

                & > ul{
                    margin-top: var(--space-s);
                    margin-bottom: var(--space-3xl);
                }
            }
        }

        .table-of-contents{
            ul{
                list-style-type: none;
                padding-left: 0;

                li:has(ul) + li :global(a:first-of-type){
                    margin-top: var(--space-m);
                }
            }
        }

        @media(prefers-reduced-motion: no-preference){

            @keyframes fadeFromSide{
                from {
                    opacity: 0;
                    translate: -1em 0;
                }
                to {
                    opacity: 1;
                    translate: 0 0;
                }
            }

            dialog{
                
                nav{
                    
                    .toc-heading > *, ul, li{
                        animation: fadeFromSide var(--duration-default) var(--ease-default) backwards;
                    }

                    ul{
                        animation-delay: 100ms;

                        li {
                            @for $i from 1 through 12 {
                                &:nth-child(#{$i}) {
                                    animation-delay: #{50 + ($i - 1) * 60}ms;
                                }
                            }
                        }
                    }

                }
            }
        } // no-preference for motion
    }

    @media only screen and (min-width: $laptop){
        .toc-wrapper{
            position: sticky;
            top: var(--space-l);

            .table-of-contents{
                display: flex;
                flex-direction: column;
                padding: var(--space-m);
                row-gap: var(--space-m);
    
                .toc-heading{
                    display: flex;
                    flex-direction: column;
                }
    
                li:has(ul) + li :global(a:first-of-type){
                    margin-top: var(--space-xs);
                }
            }

            button{
                display: none;
            }
        }
    } // $laptop
</style>
<div class="toc-wrapper">
    <nav
        class="table-of-contents"
        aria-label="Table of contents"
    >
        <div class="toc-heading">
            <ContentLink
                hyperlink={pageLink}
                type="page"
                label={page}
            />
            <small class="sans-serif">{readingTime} read</small>
        </div>
        <ul>
            { grouped.map((chapter: GroupedChapter, i: number) => {
                const chapterId = `toc-chapter-${i}`;

                return (
                    <li>
                        <ContentLink
                            type="chapter"
                            hyperlink={chapter.link}
                            id={chapterId}
                            label={chapter.label}
                        />
                        { chapter.children.length > 0 && (
                            <ul aria-labelledby={chapterId}>
                                { chapter.children.map((subchapter) => 
                                    <li>
                                        <ContentLink
                                            type="subchapter"
                                            label={subchapter.label}
                                            hyperlink={subchapter.link}
                                        />
                                    </li>
                                )}
                            </ul>
                        )}
                    </li>
                )
            })}
        </ul>
    </nav>
    <dialog
        id="toc-dialog"
        aria-label="Table of contents"
    >
        <button
            id="toc-close"
            type="button"
            aria-label="Close table of contents"
            class="hamburger"
            data-theme-mode="invert"
        >
            <Icon icon="x" scale="h5" aria-hidden="true" themeMode="invert" />
        </button>
    </dialog>

    <button
        id="toc-open"
        aria-label="Table of contents"
        aria-expanded="false"
        aria-controls="toc-dialog"
        data-theme="default"
        data-theme-mode="invert"
    >
        <Icon
            icon="book"
            scale="h5"
            aria-hidden="true"
            fill="default"
            themeMode="invert"
        />
    </button>
    <div
        class="pseudo-nav grid"
        id="pseudo-nav"
        data-theme-mode="invert"
    >
        <span>{page}</span>
        <button
            id="toc-open-scrolled"
            type="button"
            aria-label="Table of contents"
            aria-expanded="false"
            aria-controls="toc-dialog"
            class="hamburger"
            data-theme="default"
            data-theme-mode="invert"
        >
            <Icon icon="book" scale="h5" aria-hidden="true" fill="default" themeMode="invert" />
        </button>
    </div>
</div>
<script>
    const mql = window.matchMedia('(min-width: 1280px)');

    const wrapper = document.querySelector('.toc-wrapper') as HTMLElement;
    const dialogEl = document.getElementById('toc-dialog') as HTMLDialogElement;
    const nav = wrapper.querySelector('.table-of-contents') as HTMLElement;
    const button = document.getElementById('toc-open') as HTMLButtonElement;
    const closeButton = document.getElementById('toc-close') as HTMLButtonElement;

    const navEl = document.getElementById('main-menu') as HTMLElement;
    const navHeight = navEl?.getBoundingClientRect().height ?? 0 + 100;

    const pseudoNav = document.getElementById('pseudo-nav') as HTMLElement;
    const scrolledButton = document.getElementById('toc-open-scrolled') as HTMLButtonElement;

    if (!nav) throw new Error('Table of Contents not found');

    const desktopToc = () => {
        if (dialogEl.open) dialogEl.close();
        wrapper.insertBefore(nav, dialogEl);
    };

    const mobileToc = () => {
        dialogEl.prepend(nav);
    };

    mql.addEventListener('change', (e) => {
        e.matches ? desktopToc() : mobileToc();
    });

    (mql.matches ? desktopToc : mobileToc)();

    const updatePseudoNav = () => {
        pseudoNav.classList.toggle('visible', window.scrollY > navHeight);
    };

    window.addEventListener('scroll', updatePseudoNav, { passive: true });
    updatePseudoNav();

    if (dialogEl instanceof HTMLDialogElement && button instanceof HTMLButtonElement && closeButton instanceof HTMLButtonElement && scrolledButton instanceof HTMLButtonElement) {
        const setExpanded = (value: boolean) => {
            button.setAttribute('aria-expanded', value ? 'true' : 'false');
            scrolledButton.setAttribute('aria-expanded', value ? 'true' : 'false');
        };

        const openDialog = () => {
            dialogEl.showModal();
            setExpanded(true);
        };

        button.addEventListener('click', openDialog);
        scrolledButton.addEventListener('click', openDialog);

        closeButton.addEventListener('click', () => {
            dialogEl.close();
        });

        dialogEl.addEventListener('close', () => {
            setExpanded(false);
            button.focus();
        });
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.toc[href^="#"]:not([href="#top"])'));
    const headings = links
        .map((link) => document.querySelector(link.getAttribute('href') || ''))
        .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string | null) => {
        links.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('active', isActive);
            if (isActive) {
                link.setAttribute('aria-current', 'location');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    };

    const updateActiveHeading = () => {
        const triggerY = window.innerHeight * 0.1;
        let current: HTMLElement | null = null;

        for (const heading of headings) {
            if (heading.getBoundingClientRect().top <= triggerY) {
                current = heading;
            } else {
                break;
            }
        }

        setActive(current ? current.id : null);
    };

    links.forEach((link) => {
        link.addEventListener('click', () => {
            const id = link.getAttribute('href')?.replace('#', '') ?? null;
            setActive(id);

            if (dialogEl.open) {
                dialogEl.close();
            }
        });
    });

    const supportsScrollEnd = 'onscrollend' in window;

    if (supportsScrollEnd) {
        window.addEventListener('scrollend', updateActiveHeading);
    } else {
        let fallbackTimer: ReturnType<typeof setTimeout>;
        window.addEventListener('scroll', () => {
            clearTimeout(fallbackTimer);
            fallbackTimer = setTimeout(updateActiveHeading, 150);
        }, { passive: true });
    }

    updateActiveHeading();

    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
        if (location.hash) {
            requestAnimationFrame(() => {
                const target = document.querySelector(location.hash);
                target?.scrollIntoView();
            });
        }
    });
</script>