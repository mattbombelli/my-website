---
import '@style/global.scss';
import ContentLink from '@blocks/parts/ContentLink.astro';
import Icon from '@primitives/Icon.astro';

export interface Props{
    page: string;
    pageLink: string;
    chapters: {
        type: 'h1' | 'h2' | 'h3',
        label: string,
        link: string
    }[];
    readingTime?: string;
}

interface Chapter {
    type: string;
    label: string;
    link: string;
}

interface GroupedChapter extends Chapter {
    children: Chapter[];
}

const {
    page,
    pageLink,
    chapters,
    readingTime,
} = Astro.props;

const grouped = chapters.reduce<GroupedChapter[]>((acc, chapter) => {
    if (chapter.type === 'h1') return acc;

    if (chapter.type === 'h2') {
        acc.push({ ...chapter, children:[] });
    } else if (acc.length > 0) {
        acc[acc.length - 1].children.push(chapter);
    }

    return acc;
}, []);
---
<style lang="scss">
    @use '../../foundations/' as *;

    .toc-wrapper{
        button{
            appearance: none;
            -webkit-appearance: none;
            color: var(--foreground);
            display: inline-grid;
            place-items: center;
            background: var(--background);
            border: none;
            border-radius: var(--radius-pill);
            padding: var(--space-xs);
            aspect-ratio: 1/1;
            cursor: pointer;
            width: calc(var(--text-h5) + var(--space-xs) * 2);
            height: calc(var(--text-h5) + var(--space-xs) * 2);
            transition: background var(--duration-default) var(--ease-default);

            position: fixed;
            bottom: var(--space-m);
            right: var(--space-m);
            z-index: 1;
        }

        :global(body:has(dialog[open])){
            overflow: hidden;
        }

        #toc-dialog{
            background: var(--background);
            margin: 0;
            border: 0;
            height: 100dvh;
            width: 100%;
            max-width: none;
            max-height: none;
            padding: 0;

            &::backdrop{
                background: var(--background);
            }

            .toc-heading{
                padding: var(--space-m) var(--padding-inline);
                border-bottom: .12em solid var(--paper-dark);
            }

            .table-of-contents{
                ul{
                    padding: 0 var(--padding-inline);
                }
            }
        }

        .table-of-contents{
            ul{
                list-style-type: none;
                padding-left: 0;

                li:has(ul) + li :global(a:first-of-type){
                    margin-top: var(--space-m);
                }
            }
        }

        @media(prefers-reduced-motion: no-preference){

            @keyframes fadeFromSide{
                from {
                    opacity: 0;
                    translate: -1em 0;
                }
                to {
                    opacity: 1;
                    translate: 0 0;
                }
            }

            dialog{
                
                nav{
                    
                    .toc-heading > *, ul, li{
                        animation: fadeFromSide var(--duration-default) var(--ease-default) backwards;
                    }

                    ul{
                        animation-delay: 100ms;

                        li {
                            @for $i from 1 through 12 {
                                &:nth-child(#{$i}) {
                                    animation-delay: #{50 + ($i - 1) * 60}ms;
                                }
                            }
                        }
                    }

                }
            }
        } // no-preference for motion
    }

    @media only screen and (min-width: $laptop){
        .toc-wrapper{
            position: sticky;
            top: var(--space-l);

            .table-of-contents{
                display: flex;
                flex-direction: column;
                padding: var(--space-m);
                row-gap: var(--space-m);
    
                .toc-heading{
                    display: flex;
                    flex-direction: column;
                }
    
                li:has(ul) + li :global(a:first-of-type){
                    margin-top: var(--space-xs);
                }
            }

            button{
                display: none;
            }
        }
    } // $laptop
    

</style>
<div class="toc-wrapper">
        <nav
            class="table-of-contents"
            aria-label="Table of contents"
        >
            <div class="toc-heading">
                <ContentLink
                hyperlink={pageLink}
                type="page"
                label={page}
                />
                <small class="sans-serif">{readingTime} read</small>
            </div>
            <ul>
                { grouped.map((chapter: GroupedChapter, i: number) => {
                    const chapterId = `toc-chapter-${i}`;

                    return (
                        <li>
                            <ContentLink
                                type="chapter"
                                hyperlink={chapter.link}
                                id={chapterId}
                                label={chapter.label}
                            />
                            { chapter.children.length > 0 && (
                                <ul aria-labelledby={chapterId}>
                                    { chapter.children.map((subchapter) => 
                                        <li>
                                            <ContentLink
                                                type="subchapter"
                                                label={subchapter.label}
                                                hyperlink={subchapter.link}
                                            />
                                        </li>
                                    )}
                                </ul>
                            )}
                        </li>
                    )

                })}
            </ul>
        </nav>
        <dialog
            id="toc-dialog"
            aria-label="Table of contents"
        >
            <button
                id="toc-close"
                type="button"
                aria-label="Close table of contents"
                class="hamburger"
                data-theme-mode="invert"
            >
                <Icon icon="x" scale="h5" aria-hidden="true" themeMode="invert" />
            </button>
        </dialog>

        <button
            id="toc-open"
            aria-label="Open table of contents"
            aria-expanded="false"
            aria-controls="toc-dialog"
            data-theme="default"
            data-theme-mode="invert"
        >
            <Icon
                icon="book"
                scale="h5"
                aria-hidden="true"
                fill="default"
                themeMode="invert"
            />
        </button>
</div>
<script>
    // src/components/blocks/TableOfContents.astro (script block)
    const mql = window.matchMedia('(min-width: 1280px)');

    const wrapper = document.querySelector('.toc-wrapper') as HTMLElement;
    const dialogEl = document.getElementById('toc-dialog') as HTMLDialogElement;
    const nav = wrapper.querySelector('.table-of-contents') as HTMLElement;
    const button = document.getElementById('toc-open') as HTMLButtonElement;
    const closeButton = document.getElementById('toc-close') as HTMLButtonElement;

    if (!nav) throw new Error('Table of Contents not found');

    const desktopToc = () => {
        if (dialogEl.open) dialogEl.close();
        wrapper.insertBefore(nav, dialogEl);
    };

    const mobileToc = () => {
        dialogEl.prepend(nav);
    };

    mql.addEventListener('change', (e) => {
        e.matches ? desktopToc() : mobileToc();
    });

    (mql.matches ? desktopToc : mobileToc)();

    if (dialogEl instanceof HTMLDialogElement && button instanceof HTMLButtonElement && closeButton instanceof HTMLButtonElement) {
        const setExpanded = (value: boolean) => button.setAttribute('aria-expanded', value ? 'true' : 'false');

        button.addEventListener('click', () => {
            dialogEl.showModal();
            setExpanded(true);
        });

        closeButton.addEventListener('click', () => {
            dialogEl.close();
        });

        dialogEl.addEventListener('close', () => {
            setExpanded(false);
            button.focus();
        });
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.toc[href^="#"]'));
    const headings = links
        .map((link) => document.querySelector(link.getAttribute('href') || ''))
        .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string | null) => {
        links.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('active', isActive);
            if (isActive) {
                link.setAttribute('aria-current', 'location');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    };

    let suppressObserver = false;

    const updateActiveHeading = () => {
        if (suppressObserver) return;

        const triggerY = window.innerHeight * 0.1; // matches rootMargin's 10% starting point
        let current: HTMLElement | null = null;

        for (const heading of headings) {
            if (heading.getBoundingClientRect().top <= triggerY) {
                current = heading;
            } else {
                break;
            }
        }

        if (current) {
            setActive(current.id);
        }
    };

    links.forEach((link) => {
        link.addEventListener('click', () => {
            const id = link.getAttribute('href')?.replace('#', '') ?? null;
            setActive(id);

            suppressObserver = true;
            window.setTimeout(() => { suppressObserver = false; }, 1000); // long enough for smooth-scroll to fully settle

            if (dialogEl.open) {
                dialogEl.close();
            }
        });
    });

    const observer = new IntersectionObserver(updateActiveHeading, {
        rootMargin: '-10% 0px -80% 0px',
    });

    headings.forEach((heading) => observer.observe(heading));

    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
        if (location.hash) {
            requestAnimationFrame(() => {
                const target = document.querySelector(location.hash);
                target?.scrollIntoView();
            });
        }
    });
</script>