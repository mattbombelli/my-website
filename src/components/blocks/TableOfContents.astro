---
// src/components/blocks/TableOfContents.astro
import '@style/global.scss';
import ContentLink from '@blocks/parts/ContentLink.astro';
import Icon from '@primitives/Icon.astro';

export interface Props{
    page: string;
    pageLink: string;
    chapters: {
        type: 'h1' | 'h2' | 'h3',
        label: string,
        link: string
    }[];
    readingTime?: string;
}

interface Chapter {
    type: string;
    label: string;
    link: string;
}

interface GroupedChapter extends Chapter {
    children: Chapter[];
}

const {
    page,
    pageLink,
    chapters,
    readingTime,
} = Astro.props;

const grouped = chapters.reduce<GroupedChapter[]>((acc, chapter) => {
    if (chapter.type === 'h1') return acc;

    if (chapter.type === 'h2') {
        acc.push({ ...chapter, children:[] });
    } else if (acc.length > 0) {
        acc[acc.length - 1].children.push(chapter);
    }

    return acc;
}, []);
---
<style lang="scss">
    @use '../../foundations/' as *;

    #toc-sentinel {
        grid-row: 1;
        grid-column: 1;
        height: 0;

        @media only screen and (min-width: $laptop) {
            display: none;
        }
    }

    .toc-button {
        display: grid;
        align-items: center;
        padding-block: var(--space-xs);
        background: var(--background);
        color: var(--foreground);
        appearance: none;
        -webkit-appearance: none;
        border: none;
        border-bottom: .12em solid var(--ink-light);
        cursor: pointer;

        &.toc-header{
            width: 100%;
        }

        span, small {
            justify-self: left;
            @include body-text('p', 400, 'sans-serif');
        }

        .icon-visual {
            justify-self: right;
            display: inline-grid;
            place-items: center;
            aspect-ratio: 1/1;
            grid-column: 2/3;

            @media only screen and (min-width: $tablet) {
                grid-column: 4/5;
            }
        }
    } // .toc-button

    .pseudo-nav-wrapper {
        grid-row: 1 / -1;
        grid-column: 1 / -1;
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        flex-direction: column;

        @media only screen and (min-width: $laptop) {
            display: none;
        }

        progress{
            opacity: 0;
            height: var(--space-3xs);
            border: none;
            background: var(--paper-dark);
            width: 100%;
            

            &::-webkit-progress-bar {
                background: transparent;
            }
            
            &::-webkit-progress-value {
                background: var(--marmalade-base);
                transition: width var(--duration-default) var(--ease-default);
            }

            &::-moz-progress-bar {
                background: var(--marmalade-base);
            }
        }

        button.stuck + progress{
            transition: opacity var(--duration-default) var(--ease-default) 150ms;
            opacity: 1;
        }
    }

    .pseudo-nav {
        margin-left: var(--padding-inline);
        margin-right: var(--padding-inline);
        border-radius: var(--radius-sm);
        border: .12em solid var(--ink-light);

        @media (prefers-reduced-motion: no-preference) {
            transition: border-color var(--duration-default) var(--ease-default),
                        margin-left var(--duration-default) var(--ease-default),
                        margin-right var(--duration-default) var(--ease-default),
                        border var(--duration-default) var(--ease-default),
                        border-radius var(--duration-default) var(--ease-default);
        }

        &.stuck {
            border: 0;
            // border-bottom: .12em solid var(--paper-dark);
            margin-left: 0;
            margin-right: 0;
            border-radius: 0;
        }
    } // .pseudo-nav

    .toc-wrapper {
        .skip-link {
            display: none;
        }

        :global(body:has(dialog[open])) {
            overflow: hidden;
        }

        // Mobile toc
        #toc-dialog {
            background: var(--background);
            margin: 0;
            border: 0;
            height: 100dvh;
            width: 100%;
            max-width: none;
            max-height: none;
            padding: 0;

            #toc-close{
                position: sticky;
                top: 0;
                background-color: var(--background);
                z-index: 1;
            }

            &::backdrop {
                background: var(--background);
            }

            .toc-heading {
                padding: var(--space-m) var(--padding-inline);

                small {
                    @include body-text('p', 400, 'sans-serif');
                    display: block;
                }
            }

            .table-of-contents {
                ul {
                    padding: 0 var(--padding-inline);
                }

                & > ul {
                    margin-top: var(--space-s);
                    margin-bottom: var(--space-3xl);
                }
            }
        } // #toc-dialog

        .table-of-contents {
            ul {
                list-style-type: none;
                padding-left: 0;

                li:has(ul) + li :global(a.chapter:first-of-type) {
                    margin-top: var(--space-m);
                }
            }
        } // .table-of-contents

        @media (prefers-reduced-motion: no-preference) {

            @keyframes fadeFromSide {
                from {
                    opacity: 0;
                    translate: -1em 0;
                }
                to {
                    opacity: 1;
                    translate: 0 0;
                }
            }

            dialog {
                nav {
                    .toc-heading > *, ul, li {
                        animation: fadeFromSide var(--duration-default) var(--ease-default) backwards;
                    }

                    ul {
                        animation-delay: 100ms;

                        li {
                            @for $i from 1 through 12 {
                                &:nth-child(#{$i}) {
                                    animation-delay: #{50 + ($i - 1) * 60}ms;
                                }
                            }
                        }
                    }
                }
            }
        } // no-preference for motion
    } // .toc-wrapper

    @media only screen and (min-width: $laptop) {
        .toc-wrapper {
            .skip-link {
                position: absolute;
                top: -1000px;
                left: 0;
                z-index: 100;
                padding: var(--space-xs) var(--space-s);
                background: var(--background);
                color: var(--foreground);
                text-decoration: none;
                display: block;

                &:focus {
                    top: 0;
                }
            }

            .table-of-contents {
                display: flex;
                flex-direction: column;
                padding: var(--space-m);
                row-gap: var(--space-m);

                .toc-heading {
                    display: flex;
                    flex-direction: column;
                }

                ul {
                    li:has(ul) + li :global(a.chapter:first-of-type) {
                        margin-top: var(--space-xs);
                    }
                }

            }

            button {
                display: none;
            }
        }
    } // $laptop
</style>

<div id="toc-sentinel"></div>
<div class="pseudo-nav-wrapper">
    <button
        id="toc-open-scrolled"
        type="button"
        aria-label="Open table of contents"
        aria-expanded="false"
        aria-controls="toc-dialog"
        class="pseudo-nav toc-button grid"
        data-theme-mode="normal"
    >
        <span>Table of contents</span>
        <span class="icon-visual" aria-hidden="true">
            <Icon icon="list" scale="h5" fill="default" themeMode="normal" />
        </span>
    </button>
    <progress
        id="reading-progress"
        max="100"
        value="0"
        aria-label="Reading progress"
    ></progress>
</div>

<aside class="toc-wrapper">
    <a href="#article-content" class="skip-link sans-serif" data-theme-mode="invert">Skip to article</a>
    <nav
        class="table-of-contents"
        aria-label="Table of contents"
    >
        <div class="toc-heading">
            <ContentLink
                hyperlink={pageLink}
                type="page"
                label={page}
            />
            <noscript><p class="sans-serif">Table of contents</p></noscript>
            { readingTime && <small class="sans-serif">{readingTime} read</small> }
        </div>
        <ul>
            { grouped.map((chapter: GroupedChapter, i: number) => {
                const chapterId = `toc-chapter-${i}`;

                return (
                    <li>
                        <ContentLink
                            type="chapter"
                            hyperlink={chapter.link}
                            id={chapterId}
                            label={chapter.label}
                        />
                        { chapter.children.length > 0 && (
                            <ul aria-labelledby={chapterId}>
                                { chapter.children.map((subchapter) => 
                                    <li>
                                        <ContentLink
                                            type="subchapter"
                                            label={subchapter.label}
                                            hyperlink={subchapter.link}
                                        />
                                    </li>
                                )}
                            </ul>
                        )}
                    </li>
                )
            })}
        </ul>
    </nav>

    <dialog
        id="toc-dialog"
        aria-label="Table of contents"
    >
        <button
            id="toc-close"
            type="button"
            aria-label="Close table of contents"
            class="toc-button toc-header grid"
            data-theme-mode="normal"
        >
            <span class="sans-serif">Table of contents</span>
            <span class="icon-visual" aria-hidden="true">
                <Icon icon="x" scale="h5" fill="default" themeMode="normal" />
            </span>
        </button>
    </dialog>
</aside>

<noscript>
    <style lang="scss">
        aside{
            padding: var(--padding-block) var(--padding-inline);

            .toc-heading{
                a:first-of-type{
                    display: none;
                }
            }

            border-block: .12em solid var(--paper-dark);
        }
    </style>
</noscript>
<script>
    import { focusWithoutRing } from '@utils/focusWithoutRing';

    const mql = window.matchMedia('(min-width: 1280px)');

    const wrapper = document.querySelector('.toc-wrapper') as HTMLElement;
    const dialogEl = document.getElementById('toc-dialog') as HTMLDialogElement;
    const nav = wrapper.querySelector('.table-of-contents') as HTMLElement;
    const closeButton = document.getElementById('toc-close') as HTMLButtonElement;

    const sentinel = document.getElementById('toc-sentinel');
    const scrolledButton = document.getElementById('toc-open-scrolled') as HTMLButtonElement;
    const progressEl = document.getElementById('reading-progress') as HTMLProgressElement;

    if (!nav) throw new Error('Table of Contents not found');

    const desktopToc = () => {
        const hadFocus = nav.contains(document.activeElement);
        const lastFocusedLink = hadFocus ? document.activeElement as HTMLElement : null;

        if (dialogEl.open) dialogEl.close();
        wrapper.insertBefore(nav, dialogEl);

        if (lastFocusedLink) {
            lastFocusedLink.focus();
        }
    };

    const mobileToc = () => {
        const hadFocus = nav.contains(document.activeElement);
        dialogEl.appendChild(nav);

        if (hadFocus) {
            scrolledButton.focus();
        }
    };

    mql.addEventListener('change', (e) => {
        e.matches ? desktopToc() : mobileToc();
    });

    (mql.matches ? desktopToc : mobileToc)();

    if (sentinel && scrolledButton) {
        const stickyObserver = new IntersectionObserver(
            ([entry]) => {
                scrolledButton.classList.toggle('stuck', !entry.isIntersecting);
            },
            { threshold: 0 }
        );

        stickyObserver.observe(sentinel);
    }

    if (dialogEl instanceof HTMLDialogElement && closeButton instanceof HTMLButtonElement && scrolledButton instanceof HTMLButtonElement) {
        const setExpanded = (value: boolean) => {
            scrolledButton.setAttribute('aria-expanded', value ? 'true' : 'false');
        };

        const openDialog = () => {
            dialogEl.showModal();
            focusWithoutRing(closeButton);
            setExpanded(true);
        };

        scrolledButton.addEventListener('click', openDialog);

        closeButton.addEventListener('click', () => {
            dialogEl.close();
        });

        dialogEl.addEventListener('close', () => {
            setExpanded(false);
            focusWithoutRing(scrolledButton);
        });
    }

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.toc[href^="#"]:not([href="#top"])'));
    const headings = links
        .map((link) => document.querySelector(link.getAttribute('href') || ''))
        .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string | null) => {
        links.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('active', isActive);
            if (isActive) {
                link.setAttribute('aria-current', 'location');
            } else {
                link.removeAttribute('aria-current');
            }
        });
    };

    const updateActiveHeading = () => {
        const triggerY = window.innerHeight * 0.2;
        let current: HTMLElement | null = null;

        for (const heading of headings) {
            if (heading.getBoundingClientRect().top <= triggerY) {
                current = heading;
            } else {
                break;
            }
        }

        setActive(current ? current.id : null);
    };

    const updateProgress = () => {
        const article = document.querySelector('article') as HTMLElement;
        const articleTop = article.getBoundingClientRect().top + window.scrollY;
        const articleBottom = articleTop + article.scrollHeight;

        const scrolled = window.scrollY + window.innerHeight - articleTop;
        const total = articleBottom - articleTop;

        const progress = total > 0 ? Math.min(Math.max((scrolled / total) * 100, 0), 100) : 0;
        progressEl.value = progress;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    links.forEach((link) => {
        link.addEventListener('click', () => {
            const id = link.getAttribute('href')?.replace('#', '') ?? null;
            setActive(id);

            if (dialogEl.open) {
                dialogEl.close();
            }
        });
    });

    const supportsScrollEnd = 'onscrollend' in window;

    if (supportsScrollEnd) {
        window.addEventListener('scrollend', updateActiveHeading);
    } else {
        let ticking = false;
        window.addEventListener('scroll', () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateActiveHeading();
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });
    }

    updateActiveHeading();

    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }

    window.addEventListener('load', () => {
        if (location.hash) {
            requestAnimationFrame(() => {
                const target = document.querySelector(location.hash);
                target?.scrollIntoView();
            });
        }
    });
</script>