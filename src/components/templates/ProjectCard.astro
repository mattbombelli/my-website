---
import '@style/global.scss';

import PrimaryButton from '@blocks/PrimaryButton.astro';
import Figure from '@primitives/Figure.astro';
import type { ComponentProps } from 'astro/types';
import { breakpoints } from '@data/breakpoints.ts';

type ButtonProps = ComponentProps<typeof PrimaryButton>;
type FigureProps = ComponentProps<typeof Figure>;


export type props = ButtonProps & FigureProps &{
    title: string;
    excerpt: string;
    button: ButtonProps;
    readingTime?: string;
    tags?: string[];
    image: FigureProps;
    style?: string;
}

const {
    title,
    excerpt,
    readingTime,
    tags,
    button,
    image,
    style,
} = Astro.props;
---
<style lang="scss">
    @use '../../foundations' as *;

    article.project.grid.full-bleed{
        --metadata-bg: var(--background);
        padding: 0;
        gap: unset;

        .figure-container{
            order: 2;
            grid-column: span 2;
            aspect-ratio: 1/1;
            overflow:hidden;
        }

        .metadata{
            padding: var(--padding-block) var(--padding-inline);
            padding-bottom: var(--space-xl);
            order: 1;
            grid-column: span 2;
            display:flex;
            flex-direction: column;
            gap: var(--space-l);
            align-items: stretch;
            background: var(--metadata-bg);

            p{
                font-weight: 400;
            }

            .metadata-heading{
                display: flex;
                flex-direction: column;
                gap: var(--gap-y);
            }

            .excerpt-container{
                display: flex;
                flex-direction: column;
                gap: var(--gap-y);
                align-items: stretch;    
            }

            :global(a span){
                flex-basis: 100%;
            }

            .pill{
                display: inline-block;
                padding: var(--space-xs) var(--space-s);
                border-radius: var(--radius-pill);
                min-width: var(--space-2xl);
                text-align: center;

                &.reading-time{
                    background: var(--paper-dark);
                }

                &.tag{
                    background: var(--sunflower-light);
                }
            }
        } // metadata

        @media only screen and (min-width: $tablet){
            padding: 0;
            height: 100dvh;

            .figure-container{
                order: 1;
                padding: var(--padding-block) var(--padding-inline);
                padding: 0;
                width: 100%;
                height: 100%;
                display: flex;
                place-items: center;

                :global(figure){
                    height: 100%;
                    width: 100%;
                }

                :global(figure img){
                    object-fit: cover;
                    object-position: center;
                }
            }

            .metadata{
                padding: var(--padding-inline);
                order: 2;
                grid-column: span 2 / 5;
                display: flex;
                flex-direction: column;
                align-items: stretch;

                :global(a){
                    --a-height: var(--space-2xl);
                }

                :global(a span){
                    flex-basis: unset;
                    flex-grow: 1;
                    min-width: unset;
                    // padding: 0;
                }

                :global(a .decoration){
                    aspect-ratio: 1;
                }
            }
        }

        @media only screen and (min-width: $laptop){
            .figure-container{
                grid-column: span 3;
            }
            .metadata{
                grid-column: span 3 / 7;

                h2{
                    font-size: var(--text-display-lg);
                }
            }
        }

        @media only screen and (min-width: $desktop){
            .figure-container{
                grid-column: span 3;
            }
            .metadata{
                grid-column: span 3 / 7;
            }
        }
    }
</style>

<article class="grid full-bleed project">
    <div class="figure-container">
        <Figure
            {...image}
            widths={[375, 540, 768, 1024, 1453, 1920]}
            sizes={`
                (min-width: ${breakpoints.laptop}) 66vw,
                (min-width: ${breakpoints.tablet}) 50vw,
                100vw
            `}
            class="full-bleed"
        />
    </div>
    <div
        class="metadata"
        style={style}
    >
        <h2>{title}</h2>
        {
            (readingTime || tags) &&
            <div class="pills">
                <p class="sans-serif reading-time pill">{readingTime}</p>
                {tags?.map((tag: string) => (
                    <p class="sans-serif pill tag">{tag}</p>
                ))}
            </div>
        }
        <p class="sans-serif h5">
            {excerpt}
        </p>
        <PrimaryButton
            label="Read case study"
            {...button}
        />
    </div>
</article>