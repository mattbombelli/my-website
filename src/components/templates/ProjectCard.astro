---
import '@style/global.scss';

import PrimaryButton from '@blocks/PrimaryButton.astro';
import Figure from '@primitives/Figure.astro';
import type { ComponentProps } from 'astro/types';
import { breakpoints } from '@data/breakpoints.ts';

type ButtonProps = ComponentProps<typeof PrimaryButton>;
type FigureProps = ComponentProps<typeof Figure>;


export type props = ButtonProps & FigureProps &{
    title: string;
    excerpt: string;
    button: ButtonProps;
    readingTime?: string;
    image: FigureProps;
}

const {
    title,
    excerpt,
    readingTime,
    button,
    image,
} = Astro.props;
---
<style lang="scss">
    @use '../../foundations' as *;

    article.project{
        border-top: 1px dashed var(--foreground);
        :global(figure){
            order: 2;
            grid-column: span 2;
            aspect-ratio: 1/1;
            overflow:hidden;
        }
        .metadata{
            padding: 0 var(--padding-inline);
            order: 1;
            grid-column: span 2;
            display:flex;
            flex-direction: column;
            gap: var(--space-l);
            align-items: stretch;

            :global(a span){
                flex-basis: 100%;
            }
        }

        @media only screen and (min-width: $tablet){
            :global(figure){
                order: 1;
            }

            .metadata{
                order: 2;
                grid-column: span 2 / 5;
                padding: 0;

                :global(a){
                    --a-height: var(--space-2xl);
                }

                :global(a span){
                    flex-basis: unset;
                    flex-grow: 1;
                    min-width: unset;
                    padding: 0;
                }

                :global(a .decoration){
                    aspect-ratio: 1;
                }
            }
        }

        @media only screen and (min-width: $laptop){
            :global(figure){
                grid-column: span 3;
            }
            .metadata{
                grid-column: span 3 / 7;
            }
        }

        @media only screen and (min-width: $desktop){
            :global(figure){
                grid-column: span 4;
            }
            .metadata{
                grid-column: span 2 / 7;
            }
        }
    }
</style>

<article class="grid full-bleed project">
    <Figure
        {...image}
        class="full-bleed"
    />
    <div class="metadata">
        <h2>{title}</h2>
        <PrimaryButton
            label="Read case study"
            {...button}
        />
        {
            readingTime && <p class="sans-serif">{readingTime}</p>
        }
        <p class="justified">
            {excerpt}
        </p>
    </div>
</article>