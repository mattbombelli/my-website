---
import '@style/global.scss';

import { icons } from '../../data/icons.ts';

export interface Props {
    icon: keyof typeof icons;
    fill?: string;
    themeMode?: 'normal' | 'invert';
    scale?: string;
}

const {
    icon,
    fill = "default",
    themeMode = "normal",
    scale = "p",
    ...rest
} = Astro.props;

const size = `var(--text-${scale})`;
---
<style>
    .icon{
        fill: var(--foreground);
        pointer-events: none;
    }
</style>

<svg
    xmlns="http://www.w3.org/2000/svg"
    width=auto
    height={size}
    viewBox="0 0 60 60"
    preserveAspectRatio="xMidYMid meet"
    {...rest}
>
    <path 
        d={icons[icon]}
        class="icon" 
        data-theme={fill} 
        data-theme-mode={themeMode}
    />
</svg>