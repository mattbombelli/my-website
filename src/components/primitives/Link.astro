---
import '@style/global.scss';

export interface Props {
    label: string;
    href: string;
    pill?: true | false;
    theme?: string;
    activeTheme?: string;
    showActiveTheme?: boolean;
    active?: boolean;
    class?: string;
    hoverColor?: 'alt-hover' | 'no-hover';
}

const {
    label = "Page",
    href = "#",
    pill = false,
    theme = "default",
    active = false,
    showActiveTheme = false,
    activeTheme,
    class: className,
    hoverColor,
    ...rest
} = Astro.props;


const classNames = (className ?? '').trim().split(/\s+/).filter(Boolean);

const hasHeadingClass = classNames.some(c => /^h[1-6]$/.test(c));
const hasSerifClass = classNames.includes('serif');
const hasSansSerifClass = classNames.includes('sans-serif');

const baseClass = [
    ...(hasHeadingClass ? classNames : ['p', ...classNames]),
    ...(hasSerifClass || hasSansSerifClass ? [] : ['sans-serif'])
];
---
<style lang="scss">
    a.link{
        --active-page: var(--cobalt-base);

        display: inline-block;
        letter-spacing: -1.1%;
        padding: var(--space-xs) 0;
        text-decoration: none;
        color: var(--foreground);

        @media (hover: hover) and (pointer: fine){
            &:not(.pill):hover,
            &:not(.pill):focus-visible{
                text-decoration: underline;
                text-decoration-thickness: 0.12em;
                text-underline-offset: .2em;
                color: var(--ink-light);
            }

            &.alt-hover:not(.pill):hover,
            &.alt-hover:not(.pill):focus-visible{
                color: var(--paper-dark);
            }

            &.no-hover:not(.pill):hover,
            &.no-hover:not(.pill):focus-visible{
                color: var(--foreground);
            }
        }

        &.active:not(.pill){
            text-decoration: underline;
            text-decoration-thickness: 0.12em;
            text-underline-offset: .2em;
            color: var(--active-page);

            &::after{
                position: absolute;
                content: '';
                top: 50%;
                transform: translateY(-50%);
                right: 0;
                width:.5em;
                height: .5em;
                border-radius: var(--radius-pill);
                background: var(--active-page);
            }
        }
    }
    
    .link.pill{
        border:.1em solid transparent;
        padding: var(--space-xs) var(--space-s);
        border-radius: var(--radius-pill);
        transition: color var(--duration-default) var(--ease-default),
        background var(--duration-default) var(--ease-default);
        &:hover,
        &:focus-visible,
        &.active{
            background: var(--background);
        }
    }
</style>

<a
    href={href} 
    data-hover={theme} 
    data-theme={activeTheme}
    aria-current={active ? 'page' : undefined}
    class:list={[
        ...baseClass,
        "link",
        { pill: pill },
        { active: active && showActiveTheme },
    ]}
    {...rest}
>
    {label}
</a>