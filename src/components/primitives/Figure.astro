---
import '../../styles/global.scss';
import { Picture } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

type PictureProps = ComponentProps<typeof Picture>;

export type Props = PictureProps & {
    caption?: string;
    className?: string;
}

const {
    caption,
    class: className,
    ...rest
} = Astro.props;
---
<style lang="scss">
    @use '../../foundations' as *;

    figure{
        margin:0;
        display: flex;
        flex-direction: column;
        gap: var(--space-s);

        img{
            width:100%;
            height: auto;
        }

        figcaption{
            padding: 0 var(--padding-inline);
            color:var(--foreground);

            @media only screen and (min-width: $tablet){
                &{
                    padding:unset;
                }
            }
        }
    }
</style>

<figure
    class={className}
>
    <Picture 
        {...rest}
    />
    {caption && <figcaption class="small italic sans-serif">{caption}</figcaption>}
</figure>