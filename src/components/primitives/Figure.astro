---
import '@style/global.scss';
import { Picture } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

type PictureProps = ComponentProps<typeof Picture>;

export type Props = PictureProps & {
    caption?: string;
    className?: string;
    style?: string;
    role?: string;
    id?: string;
    'aria-label'?: string;
    'aria-hidden'?: string;
}

const {
    caption,
    class: className,
    style,
    role,
    id,
    'aria-label': ariaLabel,
    'aria-hidden': ariaHidden,
    ...rest
} = Astro.props;

const src = Astro.props.src;
const aspectRatio = src && typeof src === 'object' && 'width' in src && 'height' in src
    ? `${src.width} / ${src.height}`
    : undefined;

const mergedStyle = `${style ?? ''}${aspectRatio ? ` aspect-ratio: ${aspectRatio};` : ''}`;
---
<style lang="scss">
    @use '../../foundations' as *;

    figure{
        margin:0;
        
        figcaption{
            margin-top: var(--space-s);
        }
        
        picture{
            display: contents;
        }
        
        img{
            width:100%;
            height: 100%;
            object-fit:cover;
            background-image: var(--blurhash-gradient);
            background-color: var(--paper-dark);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        figcaption{
            padding: 0 var(--padding-inline);
            color:var(--foreground);

            @media only screen and (min-width: $tablet){
                &{
                    padding:unset;
                }
            }
        }
    }
</style>

<figure
    class={className}
    {role}
    {id}
    aria-label={ariaLabel}
    aria-hidden={ariaHidden}
    style={mergedStyle}
>
    <Picture 
        {...rest}
    />
    {caption && <figcaption class="small italic sans-serif">{caption}</figcaption>}
</figure>