---
import '@style/global.scss';
import { Picture } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

type PictureProps = ComponentProps<typeof Picture>;

export type Props = PictureProps & {
    caption?: string;
    className?: string;
}

const {
    caption,
    class: className,
    ...rest
} = Astro.props;
---
<style lang="scss">
    @use '../../foundations' as *;

    figure{
        margin:0;

        &:has(figcaption){
            display: flex;
            flex-direction: column;
            gap: var(--space-s);
        }

        picture{
            display: contents;
        }

        img{
            width:100%;
            height: 100%;
            object-fit:cover;
        }

        figcaption{
            padding: 0 var(--padding-inline);
            color:var(--foreground);

            @media only screen and (min-width: $tablet){
                &{
                    padding:unset;
                }
            }
        }
    }
</style>

<figure
    class={className}
>
    <Picture 
        {...rest}
    />
    {caption && <figcaption class="small italic sans-serif">{caption}</figcaption>}
</figure>