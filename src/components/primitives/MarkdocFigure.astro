---
import Figure from './Figure.astro';

export interface Props{
    src: string;
    alt: string;
    title?: string;
}

const { src, alt, title } = Astro.props;
const decodedSrc = decodeURIComponent(src);

const { default: resolvedImage } = await import(/* @vite-ignore */ decodedSrc);
console.log(src);
---
<Figure
    src={resolvedImage}
    alt={alt}
    caption={title}
/>
