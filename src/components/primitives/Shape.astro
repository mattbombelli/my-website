---
import '../../styles/global.scss';

import { shapes } from '../../data/shapes.ts';

export interface Props{
    variant: keyof typeof shapes;
    fill: string;
    mode?: string;
}

const {
    variant,
    fill,
    mode = "normal",
} = Astro.props;

---
<style>
    .shape{
        fill: var(--foreground);
    }
</style>
<svg
    xmlns="http://www.w3.org/2000/svg"
    width=auto
    height="120"
    viewBox="0 0 120 120"
    preserveAspectRatio="xMidYMid meet"
>
    <path 
        d={shapes[variant]}
        class="shape" 
        data-theme={fill} 
        data-theme-mode={mode}
    />
</svg>